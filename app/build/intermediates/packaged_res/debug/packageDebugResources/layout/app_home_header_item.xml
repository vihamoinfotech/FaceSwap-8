<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bannerCreateAi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_14sdp"
    android:layout_marginTop="@dimen/_12sdp"
    android:layout_marginBottom="@dimen/_6sdp"
    android:background="@drawable/bg_home_faceswap_card"
    android:minHeight="@dimen/_130sdp">

    <!-- Face Swap illustration (right side) -->
    <ImageView
        android:id="@+id/ivHomeAi"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_120sdp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/ic_home_ai" />

    <!-- Text content (left side) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingVertical="@dimen/_14sdp"
        android:paddingStart="@dimen/_14sdp"
        android:layout_marginEnd="@dimen/_96sdp"
        android:orientation="vertical">

        <!-- "FACE SWAP" badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pink"
            android:fontFamily="@font/poppins_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="2dp"
            android:text="@string/app_header_face_swap_upper"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_8sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/poppins_extrabold"
            android:includeFontPadding="false"
            android:text="@string/app_home_swap_your_face_text"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="@dimen/_18sdp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/poppins_regular"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/app_become_anyone_in_just_text"
            android:textColor="#99AAAACC"
            android:textSize="@dimen/_9sdp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnGenerateNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialog_button_gradient"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.01"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_7sdp"
                android:text="@string/app_home_try_now_text"
                android:textColor="@color/white"
                android:textSize="@dimen/_10sdp" />

            <!-- Cost badge -->
            <LinearLayout
                android:id="@+id/costBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:background="@drawable/bg_pill_solid"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/tvFeatureCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:text="10"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_9sdp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
