<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: Server Busy
     IDs: ivBusyIcon, tvBusyTitle, tvBusyMessage, btnRetry, btnGoBack -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:background="@drawable/bg_dialog_rounded"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/_24sdp"
        android:paddingTop="@dimen/_30sdp"
        android:paddingEnd="@dimen/_24sdp"
        android:paddingBottom="@dimen/_22sdp">

        <!-- Icon with glow -->
        <FrameLayout
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_logo_glow" />

            <ImageView
                android:id="@+id/ivBusyIcon"
                android:layout_width="@dimen/_52sdp"
                android:layout_height="@dimen/_52sdp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_dialog_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_trans_close" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvBusyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/server_busy_title"
            android:textColor="@color/white"
            android:textSize="@dimen/_18sdp" />

        <!-- Gradient accent bar -->
        <View
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_badge_orange" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvBusyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/server_busy_message"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12sdp" />

        <!-- Try Again button -->
        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:background="@drawable/bg_dialog_button_gradient"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/server_busy_retry"
            android:textColor="@color/white"
            android:textSize="@dimen/_14sdp" />

        <!-- Go Back (secondary) -->
        <TextView
            android:id="@+id/btnGoBack"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/server_busy_go_back"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/_12sdp" />

    </LinearLayout>
</FrameLayout>
