<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: Insufficient Coins (Two-Option)
     IDs: ivDialogIcon, tvDialogTitle, tvCostInfo, tvBalanceInfo,
          btnBuyCoins, btnWatchAd, btnDialogClose -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_rounded"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:paddingStart="@dimen/_24sdp"
        android:paddingTop="@dimen/_36sdp"
        android:paddingEnd="@dimen/_24sdp"
        android:paddingBottom="@dimen/_24sdp">

        <!-- Coin icon with gradient glow ring -->
        <FrameLayout
            android:layout_width="@dimen/_88sdp"
            android:layout_height="@dimen/_88sdp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_logo_glow" />

            <ImageView
                android:id="@+id/ivDialogIcon"
                android:layout_width="@dimen/_56sdp"
                android:layout_height="@dimen/_56sdp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_dialog_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_coin" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/dialog_insufficient_title"
            android:textColor="@color/white"
            android:textSize="@dimen/_20sdp" />

        <!-- Gradient accent divider -->
        <View
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_badge_orange" />

        <!-- Cost info -->
        <TextView
            android:id="@+id/tvCostInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/insufficient_coins_required_10_coins"
            android:textColor="@color/warning"
            android:textSize="@dimen/_13sdp" />

        <!-- Balance info -->
        <TextView
            android:id="@+id/tvBalanceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/insufficient_coins_your_balance_0_coins"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_11sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_dialog_button_gradient"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBuyCoins"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="@string/dialog_buy_coins"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sdp" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/btnDialogClose"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_gravity="end|top"
        android:layout_marginTop="@dimen/_11sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:background="@drawable/common_border"
        android:contentDescription="@string/cd_dialog_close"
        android:padding="@dimen/_1sdp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_trans_close" />

</FrameLayout>
