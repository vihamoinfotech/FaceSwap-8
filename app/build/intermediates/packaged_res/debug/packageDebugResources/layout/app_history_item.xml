<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/app_plan_face_card_black"
    android:padding="@dimen/_12sdp"
    android:layout_marginStart="@dimen/_12sdp"
    android:layout_marginEnd="@dimen/_12sdp"
    android:layout_marginBottom="@dimen/_10sdp"
    android:gravity="center_vertical"
    android:elevation="2dp">

    <!-- Thumbnail with slight corner rounding -->
    <FrameLayout
        android:layout_width="@dimen/_70sdp"
        android:layout_height="@dimen/_70sdp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivHistoryThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/app_base_card_background"
            app:shapeAppearanceOverlay="@style/RoundedCornerImage" />
        <ImageView
            android:id="@+id/ivPlayIcon"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_gravity="center"
            android:src="@drawable/app_play_face_button"
            android:background="@drawable/app_face_circle_translucent_pie"
            android:padding="@dimen/_6sdp"
            app:tint="@color/white"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Info column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/_12sdp"
        android:orientation="vertical">

        <!-- Feature type label -->
        <TextView
            android:id="@+id/tvFeatureType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/app_poppins_semibold"
            android:textColor="@color/white"
            android:textSize="@dimen/_13sdp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Status chip -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/app_poppins_medium"
            android:textSize="@dimen/_10sdp"
            android:maxLines="1"
            android:includeFontPadding="false" />

        <!-- Date / Time -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/app_poppins_regular"
            android:textColor="@color/app_tertiary_text"
            android:textSize="@dimen/_9sdp"
            android:maxLines="1"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Credits consumed pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="@drawable/app_face_badge_orange_gradient_bg"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_4sdp">

        <ImageView
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:src="@drawable/app_face_coin_new"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvCredits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_3sdp"
            android:fontFamily="@font/app_poppins_semibold"
            android:textColor="@color/white"
            android:textSize="@dimen/_10sdp"
            android:includeFontPadding="false" />

    </LinearLayout>

</LinearLayout>
