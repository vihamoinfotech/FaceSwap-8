<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_theme_dark_background"
    tools:context=".FaceSelectionActivity">

    <LinearLayout
        android:id="@+id/faceSelectionContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:paddingHorizontal="@dimen/_6sdp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/app_face_all_view_layer"
                android:contentDescription="@string/app_face_back_text"
                android:padding="@dimen/_10sdp"
                android:scaleType="centerInside"
                android:src="@drawable/app_face_arrow_back"
                app:tint="@color/white" />

            <TextView
                style="@style/HeaderTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_toEndOf="@id/btnBack"
                android:includeFontPadding="false"
                android:text="@string/app_select_face_text" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/app_subtle_divider" />

        <!-- Hint below header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/app_poppins_regular"
            android:includeFontPadding="false"
            android:text="@string/app_select_which_face_you_text"
            android:textColor="@color/app_tertiary_text"
            android:textSize="@dimen/_10sdp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFaces"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="@dimen/_12sdp" />
    </LinearLayout>
</RelativeLayout>
