<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lottieLoadingContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_theme_dark_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ad_view_container">

        <!-- Lottie animation centered -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lotti"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_above="@+id/ll_info"
            android:layout_marginHorizontal="@dimen/_40sdp"
            android:adjustViewBounds="true"
            app:lottie_autoPlay="true"
            app:lottie_fileName="createAnimation/data.json"
            app:lottie_imageAssetsFolder="createAnimation/images"
            app:lottie_loop="true" />

        <!-- Text block below animation -->
        <LinearLayout
            android:id="@+id/ll_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLoadingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:text="@string/app_face_ai_creating_your_ai_image_text"
                android:textColor="@color/white"
                android:textSize="@dimen/_15sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:text="@string/app_face_ai_this_may_take_seconds_text"
                android:textColor="@color/app_tertiary_text"
                android:textSize="@dimen/_11sdp" />

        </LinearLayout>

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/ad_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginVertical="@dimen/_2sdp" />

</RelativeLayout>
