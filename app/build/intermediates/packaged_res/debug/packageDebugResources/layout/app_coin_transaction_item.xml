<?xml version="1.0" encoding="utf-8"?>
<!-- Item layout for a single coin transaction -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_face_common_border_color"
    android:layout_marginBottom="@dimen/_8sdp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingVertical="@dimen/_14sdp">

    <!-- Icon badge -->
    <LinearLayout
        android:id="@+id/iconBadge"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:background="@drawable/app_face_badge_orange_gradient_bg"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivTransactionIcon"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:contentDescription="@null"
            android:src="@drawable/app_face_coin_new" />
    </LinearLayout>

    <!-- Transaction details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTransactionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/app_poppins_medium"
            android:includeFontPadding="false"
            android:text="@string/app_face_coin_history_face_swap_text"
            android:textColor="@color/white"
            android:textSize="@dimen/_13sdp" />

        <TextView
            android:id="@+id/tvTransactionDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/app_poppins_regular"
            android:includeFontPadding="false"
            android:text="@string/app_coin_transaction_time_text"
            android:textColor="@color/app_tertiary_text"
            android:textSize="@dimen/_10sdp" />
    </LinearLayout>

    <!-- Amount -->
    <TextView
        android:id="@+id/tvTransactionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/app_poppins_bold"
        android:includeFontPadding="false"
        android:text="-10"
        android:textColor="@color/app_error_color"
        android:textSize="@dimen/_14sdp" />
</LinearLayout>
