<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: Info With Images (Photo Tips)
     IDs: ivDialogImage, tvDialogTitle, tvDialogMessage, btnDialogPositive -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/app_face_dialog_rounded_slight"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:paddingStart="@dimen/_12sdp"
        android:paddingTop="@dimen/_28sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_20sdp">

        <!-- Single selfie photo tip image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivDialogImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/face_dialog_image_text"
            android:scaleType="centerInside"
            app:shapeAppearanceOverlay="@style/RoundedImageMedium" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:fontFamily="@font/app_poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/app_info_dialog_title_text"
            android:textColor="@color/white"
            android:textSize="@dimen/_20sdp" />

        <!-- Gradient accent divider -->
        <View
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/app_face_badge_orange_gradient_bg" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvDialogMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:fontFamily="@font/app_poppins_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/app_info_dialog_message_text"
            android:textColor="@color/app_secondary_text"
            android:textSize="@dimen/_12sdp" />

        <!-- Action button -->
        <TextView
            android:id="@+id/btnDialogPositive"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginTop="@dimen/_22sdp"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:background="@drawable/app_face_dialog_button_gradient_horizontal"
            android:fontFamily="@font/app_poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="@string/app_info_dialog_button_text"
            android:textColor="@color/white"
            android:textSize="@dimen/_14sdp" />

    </LinearLayout>

</FrameLayout>
