<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_20sdp">

    <!-- Main Dialog Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_rounded"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/_16sdp"
        android:paddingTop="@dimen/_24sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:paddingBottom="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_10sdp">

        <!-- Top Icon -->
        <FrameLayout
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_logo_spread_glow" />

            <ImageView
                android:id="@+id/ivDialogIcon"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="@dimen/_48sdp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_dialog_icon_text"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_filled" />

        </FrameLayout>
<!--        android:text="Enjoying FaceSwap? 🌟"-->
        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Enjoying FaceSwap ?"
            android:textColor="@color/white"
            android:textSize="@dimen/_18sdp" />

        <!-- Divider -->
        <View
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_badge_orange" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvDialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:text="Your support means the world to us! Please take a moment to rate your experience."
            android:textColor="@color/app_secondary_text"
            android:textSize="@dimen/_12sdp" />

        <!-- Stars Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:background="@drawable/bg_plan_card_unselected"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_8sdp">

            <ImageView
                android:id="@+id/ivStar1"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:contentDescription="1 Star"
                android:padding="@dimen/_4sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_empty" />

            <ImageView
                android:id="@+id/ivStar2"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:contentDescription="2 Stars"
                android:padding="@dimen/_4sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_empty" />

            <ImageView
                android:id="@+id/ivStar3"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:contentDescription="3 Stars"
                android:padding="@dimen/_4sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_empty" />

            <ImageView
                android:id="@+id/ivStar4"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:contentDescription="4 Stars"
                android:padding="@dimen/_4sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_empty" />

            <ImageView
                android:id="@+id/ivStar5"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:contentDescription="5 Stars"
                android:padding="@dimen/_4sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_empty" />

        </LinearLayout>

        <!-- Hint -->
        <TextView
            android:id="@+id/tvFeedbackHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Tap a star to rate us"
            android:textColor="@color/app_tertiary_text"
            android:textSize="@dimen/_11sdp" />

    </LinearLayout>

    <!-- Close Button -->
    <ImageView
        android:id="@+id/btnDialogClose"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_gravity="end|top"
        android:layout_marginTop="@dimen/_11sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:background="@drawable/bg_close_button"
        android:contentDescription="@string/face_dialog_close_text"
        android:padding="@dimen/_1sdp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_trans_close" />

</FrameLayout>