<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient border (outer) — highlighted for featured/popular plans -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/badge_popular_start"
                android:endColor="@color/badge_popular_end" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Inner fill -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A1830" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
