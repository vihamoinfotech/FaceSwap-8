<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

<!-- Gradient Border (outer layer) -->
<item>
    <shape>
        <gradient
            android:startColor="#4C55FF"
            android:endColor="#A057FF"
            android:angle="0"/>
        <corners android:radius="100dp"/>
    </shape>
</item>

<!-- Inner background (creates border effect) -->
<item android:inset="2dp">
    <shape>
        <solid android:color="#1A1230"/>
        <corners android:radius="100dp"/>
    </shape>
</item>

</layer-list>