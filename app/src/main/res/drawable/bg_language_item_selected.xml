<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Gradient Border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/app_start_gradient"
                android:endColor="@color/app_end_gradient" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Inner Solid Background -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A192E" />
            <corners android:radius="14.5dp" />
        </shape>
    </item>
</layer-list>
