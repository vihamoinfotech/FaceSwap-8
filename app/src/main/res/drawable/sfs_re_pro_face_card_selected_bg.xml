<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glowing neon gradient border (outer) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#06B6D4"
                android:endColor="#6366F1" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Inner fill with glowing surface color -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1B1A35" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
