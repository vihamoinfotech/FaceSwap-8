<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle border (outer) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/border_soft" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Inner fill -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#141424" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
