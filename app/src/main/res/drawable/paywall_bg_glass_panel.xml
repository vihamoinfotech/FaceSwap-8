<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer: subtle white glass-edge stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paywall_glass_stroke" />
            <corners android:radius="@dimen/_18sdp" />
        </shape>
    </item>
    <!-- Inner: frosted dark purple fill (1dp inset for 1px stroke) -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/paywall_glass_fill" />
            <corners android:radius="@dimen/_18sdp" />
        </shape>
    </item>
</layer-list>
