<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bannerCreateAi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_16sdp"
    android:layout_marginTop="@dimen/_14sdp"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/app_home_hero_banner_bg"
    android:elevation="12dp"
    android:minHeight="@dimen/_140sdp"
    android:clipToOutline="true">

    <!-- Sparkle animation (top right) -->
    <TextView
        android:id="@+id/ivSparkle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:text="✦"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_24sdp" />

    <!-- Text content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:paddingVertical="@dimen/_14sdp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:orientation="vertical">

        <!-- AI STUDIO badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/app_face_badge_pink_gradient_bg"
            android:fontFamily="@font/app_poppins_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:text="@string/app_home_hero_badge"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_8sdp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:fontFamily="@font/app_poppins_extrabold"
            android:includeFontPadding="false"
            android:text="@string/app_home_hero_title"
            android:lineSpacingExtra="-4dp"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_22sdp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/app_poppins_regular"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/app_home_hero_subtitle"
            android:textColor="#D1D5DB"
            android:textSize="@dimen/_10sdp" />

        <!-- CTAs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Face Swap CTA -->
            <LinearLayout
                android:id="@+id/btnFaceSwap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/app_home_hero_cta_btn_bg"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_8sdp">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:src="@drawable/app_face_rotation_face_swap_bg"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:fontFamily="@font/app_poppins_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/app_home_face_swap_cta"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_10sdp" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/_8sdp"
                android:layout_height="wrap_content" />

            <!-- AI Create CTA -->
            <LinearLayout
                android:id="@+id/btnAiCreate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/app_home_hero_cta_btn_bg"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/_8sdp">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:src="@drawable/app_face_generative_chat_ai"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:fontFamily="@font/app_poppins_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/app_home_ai_create_cta"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_10sdp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
