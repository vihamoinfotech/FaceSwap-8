<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg_paywall">

    <RelativeLayout
        android:id="@+id/paywallRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


    <!-- ═══════════════════════════════════════════════════
         SCROLLABLE CONTENT
         ═══════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/paywallScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/paywallFooter"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- ─────────────────────────────────────────────
                 HERO SECTION
                 ───────────────────────────────────────────── -->

            <!-- Premium Badge Row -->
            <LinearLayout
                android:id="@+id/paywallHeroBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Purple diamond icon box -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/app_face_premium_center_button">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/app_face_diamond_premium"
                        android:scaleType="centerInside" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/app_poppins_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="@string/paywall_premium_label"
                    android:textColor="@color/app_on_surface_paywall"
                    android:textSize="20sp" />

            </LinearLayout>

            <!-- Hero Headlines -->
            <LinearLayout
                android:id="@+id/paywallHeroText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/app_poppins_medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="@string/paywall_hero_line1"
                    android:textColor="@color/app_on_surface_paywall"
                    android:textSize="@dimen/_22sdp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/app_poppins_medium"
                    android:includeFontPadding="false"
                    android:text="@string/paywall_hero_line2"
                    android:textColor="@color/app_on_surface_paywall"
                    android:textSize="@dimen/_22sdp" />

                <TextView
                    android:id="@+id/tvPaywallHeroTrial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/app_poppins_bold"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/app_on_surface_paywall"
                    android:lines="1"
                    android:ellipsize="end"
                    android:textSize="@dimen/_22sdp" />
            </LinearLayout>

            <!-- ─────────────────────────────────────────────
                 FEATURE COMPARISON — GLASS PANEL
                 ───────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/paywallFeaturePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18sdp"
                android:background="@drawable/app_face_glass_panel_gray"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp">

                <!-- ── TABLE HEADER ROW ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <!-- Feature name spacer (weight 3) -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="3" />

                    <!-- Basic column header (weight 1) -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:fontFamily="@font/app_poppins_medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingBottom="8dp"
                        android:text="@string/paywall_col_basic"
                        android:textColor="@color/app_on_surface_variant_paywall"
                        android:textSize="@dimen/_11sdp" />

                    <!-- Pro column header (weight 1) — solid purple top -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/app_face_pro_header_light"
                        android:fontFamily="@font/app_poppins_medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingVertical="8dp"
                        android:text="@string/paywall_col_pro"
                        android:textColor="@color/app_on_primary_paywall"
                        android:textSize="@dimen/_11sdp" />
                </LinearLayout>

                <!-- ══════════════════════════════════════════
                     FEATURE ROW 1: No Ads
                     ══════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/ll_exclusive_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="3"
                        android:fontFamily="@font/app_poppins_medium"
                        android:includeFontPadding="false"
                        android:paddingVertical="@dimen/_10sdp"
                        android:text="Exclusive Content"
                        android:textColor="@color/app_on_surface_paywall"
                        android:textSize="@dimen/_13sdp" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/app_poppins_medium"
                            android:text="✕"
                            android:textColor="#9CA3AF"
                            android:textSize="@dimen/_14sdp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/app_face_premium_pro_column_light">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/app_poppins_bold"
                            android:text="✓"
                            android:textColor="@color/app_primary_brand"
                            android:textSize="@dimen/_16sdp" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="3"
                        android:fontFamily="@font/app_poppins_medium"
                        android:includeFontPadding="false"
                        android:paddingVertical="14dp"
                        android:text="HD Export Quality"
                        android:textColor="@color/app_on_surface_paywall"
                        android:textSize="@dimen/_13sdp"/>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/app_poppins_medium"
                            android:text="✕"
                            android:textColor="#9CA3AF"
                            android:textSize="@dimen/_14sdp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/app_face_premium_pro_column_light">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/app_poppins_bold"
                            android:text="✓"
                            android:textColor="@color/app_primary_brand"
                            android:textSize="@dimen/_16sdp" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="3"
                        android:fontFamily="@font/app_poppins_medium"
                        android:includeFontPadding="false"
                        android:paddingVertical="14dp"
                        android:text="Faster Processing"
                        android:textColor="@color/app_on_surface_paywall"
                        android:textSize="@dimen/_13sdp" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/app_poppins_medium"
                            android:text="✕"
                            android:textColor="#9CA3AF"
                            android:textSize="@dimen/_14sdp" />
                    </FrameLayout>

                    <!-- Last Pro cell: rounded bottom corners -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/app_face_premium_pro_column_light">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/app_poppins_bold"
                            android:text="✓"
                            android:textColor="@color/app_primary_brand"
                            android:textSize="@dimen/_16sdp" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="3"
                        android:fontFamily="@font/app_poppins_medium"
                        android:includeFontPadding="false"
                        android:paddingVertical="14dp"
                        android:text="Unlimited Downloads"
                        android:textColor="@color/app_on_surface_paywall"
                        android:textSize="@dimen/_13sdp"/>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/app_poppins_medium"
                            android:text="✕"
                            android:textColor="#9CA3AF"
                            android:textSize="@dimen/_14sdp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/app_face_premium_pro_column_light">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/app_poppins_bold"
                            android:text="✓"
                            android:textColor="@color/app_primary_brand"
                            android:textSize="@dimen/_16sdp" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="3"
                        android:fontFamily="@font/app_poppins_medium"
                        android:includeFontPadding="false"
                        android:paddingVertical="14dp"
                        android:text="Ad-Free Experience"
                        android:textColor="@color/app_on_surface_paywall"
                        android:textSize="@dimen/_13sdp" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/app_poppins_medium"
                            android:text="✕"
                            android:textColor="#9CA3AF"
                            android:textSize="@dimen/_14sdp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/app_face_pro_column_bottom_light">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/app_poppins_bold"
                            android:text="✓"
                            android:textColor="@color/app_primary_brand"
                            android:textSize="@dimen/_16sdp" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


        <ImageView
            android:id="@+id/btnPaywallClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/paywall_close"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:alpha="0.4"
            android:src="@drawable/app_transparent_close_choose" />


        <!-- ═══════════════════════════════════════════════════
             FIXED FOOTER — CTA + links
             ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/paywallFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/app_face_premium_bg_footer"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="@dimen/_16sdp"
        android:paddingBottom="@dimen/_9sdp">

        <!-- Price detail text above CTA button -->
        <TextView
            android:id="@+id/tv_gol_offer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/app_poppins_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#1A1A2E"
            android:textSize="@dimen/_18sdp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tv_gol_offer_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/app_poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#1A1A2E"
            android:textSize="@dimen/_22sdp"
            android:visibility="visible" />




        <!-- CTA Button (uses app's own brand gradient for consistency) -->
        <TextView
            android:id="@+id/btnPaywallCta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/app_face_premium_center_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/app_poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingVertical="16dp"
            android:text="Subscribe Now"
            android:textColor="@color/white"
            android:textSize="@dimen/_15sdp" />

        <TextView
            android:id="@+id/tvPaywallPriceDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/app_poppins_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/app_on_surface_variant_paywall"
            android:textSize="@dimen/_11sdp"
            android:visibility="visible" />

        <!-- Footer Links: Restore | Privacy | Terms -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPaywallTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:text="@string/paywall_terms"
                android:textColor="@color/app_outline_variant_paywall"
                android:fontFamily="@font/app_poppins_regular"
                android:alpha="0.4"
                android:textSize="@dimen/_9sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="|"
                android:textColor="@color/app_outline_variant_paywall"
                android:alpha="0.4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnPaywallRestore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:text="@string/paywall_restore"
                android:textColor="@color/app_outline_variant_paywall"
                android:fontFamily="@font/app_poppins_regular"
                android:alpha="0.4"
                android:textSize="@dimen/_9sdp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="|"
                android:textColor="@color/app_outline_variant_paywall"
                android:alpha="0.4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnPaywallPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:text="@string/paywall_privacy"
                android:textColor="@color/app_outline_variant_paywall"
                android:fontFamily="@font/app_poppins_regular"
                android:alpha="0.4"
                android:textSize="@dimen/_9sdp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Centered Loading Spinner -->
    <ProgressBar
        android:id="@+id/paywallProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/app_primary_paywall"
        android:visibility="gone" />

    </RelativeLayout>

</RelativeLayout>
