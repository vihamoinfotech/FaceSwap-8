<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_theme_dark_background"
    android:orientation="vertical"
    tools:context=".view.AppFaceBackgroundPickerActivity">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:paddingHorizontal="@dimen/app_screen_padding_horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/app_face_all_view_layer"
            android:contentDescription="@string/app_face_back_text"
            android:padding="@dimen/_10sdp"
            android:scaleType="centerInside"
            android:src="@drawable/app_face_arrow_back"
            app:tint="#1A1A2E" />

        <TextView
            style="@style/HeaderTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_toEndOf="@id/btnBack"
            android:includeFontPadding="false"
            android:text="@string/app_picker_choose_background_text" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/app_subtle_divider" />

    <!-- Subtitle hint -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:fontFamily="@font/app_poppins_regular"
        android:includeFontPadding="false"
        android:text="@string/app_picker_tap_any_background_to_apply_text"
        android:textColor="@color/app_tertiary_text"
        android:textSize="@dimen/_10sdp" />

    <!-- Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBackgrounds"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:padding="@dimen/_10sdp"
        android:scrollbars="none" />

</LinearLayout>
