<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sfs_face_re_bottom_bkg_sheet"
    android:orientation="vertical"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_28sdp">

    <!-- Drag handle pill -->
    <View
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_18sdp"
        android:background="#4DFFFFFF" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:fontFamily="@font/sfs_re_poppins_semibold"
        android:includeFontPadding="false"
        android:text="Choose Video Source"
        android:textColor="#1A1A2E"
        android:textSize="@dimen/_16sdp" />

    <!-- ── Camera option ── -->
    <LinearLayout
        android:id="@+id/optionCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_14sdp">

        <LinearLayout
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:background="@drawable/sfs_face_re_bfge_orange_gradient_bg"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:contentDescription="@null"
                android:src="@drawable/sfs_re_play_face_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sfs_re_poppins_semibold"
                android:includeFontPadding="false"
                android:text="Record Video"
                android:textColor="#1A1A2E"
                android:textSize="@dimen/_13sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sfs_re_poppins_regular"
                android:includeFontPadding="false"
                android:text="Use your camera to record"
                android:textColor="@color/sfs_re_tertiary_text"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:alpha="0.4"
            android:contentDescription="@null"
            android:src="@drawable/sfs_face_re_arw_right"
            app:tint="#1A1A2E" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:background="@color/sfs_re_subtle_divider" />

    <!-- ── Gallery option ── -->
    <LinearLayout
        android:id="@+id/optionGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_14sdp">

        <LinearLayout
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:background="@drawable/sfs_face_re_bfge_orange_gradient_bg"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:contentDescription="@null"
                android:src="@drawable/sfs_face_re_gallery_open" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sfs_re_poppins_semibold"
                android:includeFontPadding="false"
                android:text="Choose from Gallery"
                android:textColor="#1A1A2E"
                android:textSize="@dimen/_13sdp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sfs_re_poppins_regular"
                android:includeFontPadding="false"
                android:text="Select from your videos"
                android:textColor="@color/sfs_re_tertiary_text"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:alpha="0.4"
            android:contentDescription="@null"
            android:src="@drawable/sfs_face_re_arw_right"
            app:tint="#1A1A2E" />
    </LinearLayout>

    <!-- Cancel -->
    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:background="@drawable/sfs_face_re_common_border_color"
        android:elevation="8dp"
                    android:fontFamily="@font/sfs_re_poppins_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/sfs_re_source_cancel_text"
        android:textColor="@color/sfs_re_secondary_text"
        android:textSize="@dimen/_13sdp" />

</LinearLayout>
