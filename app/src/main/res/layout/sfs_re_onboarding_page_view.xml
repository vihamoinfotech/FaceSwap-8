<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Skip button top-right -->
    <TextView
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:background="@drawable/sfs_face_re_common_border_color"
        android:elevation="8dp"
                    android:layout_alignParentEnd="true"
        android:fontFamily="@font/sfs_re_manrope_semibold"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_20sdp"
        android:includeFontPadding="false"
        android:text="@string/sfs_face_re_skip_text"
        android:textAllCaps="false"
        android:textColor="#1A1A2E"
        android:textSize="@dimen/_12sdp" />

    <!-- Hero onboard image fills vertical space between skip and bottom block -->
    <ImageView
        android:id="@+id/ivOnboardImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/btnNext"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/ll_details"
        android:padding="@dimen/_10sdp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <!-- Bottom content block -->
    <LinearLayout
        android:id="@+id/ll_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/_20sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOnboardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sfs_re_manrope_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/_24sdp"
            android:textColor="#1A1A2E"
            android:textSize="@dimen/_20sdp"
            android:lineSpacingMultiplier="1.2" />

        <!-- Accent underline -->
        <View
            android:layout_width="42dp"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:background="@color/sfs_re_primary_style" />

        <TextView
            android:id="@+id/tvOnboardSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/sfs_re_manrope_regular"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:includeFontPadding="false"
            android:textColor="@color/sfs_re_secondary_text"
            android:textSize="@dimen/_12sdp" />

        <!-- Continue / Next button -->
        <TextView
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:background="@drawable/sfs_re_dlog_gradient_intro_button_full"
            android:fontFamily="@font/sfs_re_manrope_medium"
            android:gravity="center"
            android:layout_marginTop="@dimen/_14sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:includeFontPadding="false"
            android:text="@string/sfs_re_onboard_continue_text"
            android:textAllCaps="false"
            android:textColor="@color/sfs_white"
            android:textSize="@dimen/_14sdp" />

    </LinearLayout>

</RelativeLayout>
