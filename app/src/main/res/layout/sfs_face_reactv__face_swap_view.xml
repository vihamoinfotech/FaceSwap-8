<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sfs_re_theme_dark_bkg">

    <RelativeLayout
        android:id="@+id/faceSwapContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header bar -->
        <RelativeLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="@dimen/sfs_re_view_padding_horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/sfs_face_re_all_view_layer"
                android:contentDescription="@string/sfs_face_re_back_text"
                android:padding="@dimen/_10sdp"
                android:scaleType="centerInside"
                android:src="@drawable/sfs_face_re_arw_back"
                app:tint="#1A1A2E" />

            <TextView
                style="@style/SFS_HeaderTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_toEndOf="@id/btnBack"
                android:includeFontPadding="false"
                android:text="@string/sfs_re_single_face_swap_text" />
        </RelativeLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/llHeader"
            android:background="@color/sfs_re_subtle_divider" />

        <!-- Generate button (bottom, fixed) -->


        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/second_ad_view_container"
            android:layout_below="@id/divider"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/sfs_re_view_padding_horizontal"
                android:paddingTop="@dimen/_18sdp"
                android:paddingBottom="@dimen/_12sdp">

                <!-- Hero headline -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sfs_re_manrope_bold"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_ai_swap_face_your_text"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_22sdp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sfs_re_manrope_extrabold"
                        android:includeFontPadding="false"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:text="@string/sfs_face_re_swap_face_text"
                        android:textColor="@color/sfs_re_primary_brand"
                        android:textSize="@dimen/_22sdp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_20sdp"
                    style="@style/SFS_SubtitleTextStyle"
                    android:text="@string/sfs_re_swap_pick_a_template_text" />

                <!-- ── Section 1: Target Template ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:background="@drawable/sfs_face_re_common_border_color"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    >

                    <!-- Section header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_20sdp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:layout_marginHorizontal="@dimen/_16sdp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/sfs_re_icon_container_size"
                            android:layout_height="@dimen/sfs_re_icon_container_size"
                            android:background="@drawable/sfs_face_re_bfge_orange_gradient_bg"
                            android:contentDescription="@null"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/sfs_face_re_gallery_open" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/sfs_re_manrope_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/sfs_re_swap_target_template_text"
                                android:textColor="#1A1A2E"
                                android:textSize="@dimen/_14sdp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/SFS_SubtitleTextStyle"
                                android:text="@string/sfs_re_swap_gallery_or_preset_text" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/sfs_face_re_bfge_orange_gradient_bg"
                            android:fontFamily="@font/sfs_re_manrope_semibold"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="@dimen/_9sdp"
                            android:paddingVertical="@dimen/_3sdp"
                            android:text="@string/sfs_re_swap_step_1_first_text"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_8sdp" />
                    </LinearLayout>

                    <!-- Template preview image -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivMainPreview"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_300sdp"
                        android:layout_marginHorizontal="@dimen/sfs_re_card_inner_padding"
                        android:background="@color/sfs_re_elevated_surface"
                        android:scaleType="centerCrop"
                        android:layout_marginBottom="@dimen/_6sdp"
                        app:shapeAppearanceOverlay="@style/SFS_RoundedCornerPhoto" />

                    <!-- Select template placeholder -->
                    <LinearLayout
                        android:id="@+id/llSelectTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginHorizontal="@dimen/sfs_re_card_inner_padding"
                        android:background="@drawable/sfs_face_re_dashed_border_purple"
                        android:gravity="center"
                        android:minHeight="@dimen/_200sdp"
                        android:orientation="vertical"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:padding="@dimen/_20sdp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/_44sdp"
                            android:layout_height="@dimen/_44sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/sfs_face_re_choose_image" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:fontFamily="@font/sfs_re_manrope_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/sfs_re_swap_tap_to_select_text"
                            android:textColor="#1A1A2E"
                            android:textSize="@dimen/_13sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/sfs_re_manrope_regular"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/sfs_re_swap_choose_from_gallery_presets_text"
                            android:textColor="@color/sfs_re_tertiary_text"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/ad_view_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_16sdp"
                         />
                </LinearLayout>

                <!-- ── Section 2: Face Upload ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sfs_face_re_common_border_color"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_20sdp">

                    <!-- Section header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_20sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/sfs_re_icon_container_size"
                            android:layout_height="@dimen/sfs_re_icon_container_size"
                            android:background="@drawable/sfs_face_re_bfge_orange_gradient_bg"
                            android:contentDescription="@null"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/sfs_re_middle_face_upload" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/sfs_re_manrope_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/sfs_re_swap_your_face_photo_text"
                                android:textColor="#1A1A2E"
                                android:textSize="@dimen/_14sdp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/SFS_SubtitleTextStyle"
                                android:text="@string/sfs_re_swap_clear_frontal_photo_works_text" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/sfs_face_re_bfge_orange_gradient_bg"
                            android:fontFamily="@font/sfs_re_manrope_semibold"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="@dimen/_9sdp"
                            android:paddingVertical="@dimen/_3sdp"
                            android:text="@string/sfs_re_swap_step_2_second_text"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_8sdp" />
                    </LinearLayout>

                    <!-- Face slots row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:orientation="horizontal">

                        <!-- Add face button -->

                        <!-- Uploaded face preview -->
                        <RelativeLayout
                            android:id="@+id/btnAddFace"
                            android:layout_width="@dimen/_64sdp"
                            android:layout_height="@dimen/_64sdp"
                            android:background="@drawable/sfs_face_re_dashed_border_purple">

                            <ImageView
                                android:layout_width="@dimen/_35sdp"
                                android:layout_height="@dimen/_35sdp"
                                android:layout_centerInParent="true"
                                android:contentDescription="@null"
                                android:src="@drawable/sfs_face_re_gradient_normal_plus" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/rlUploadedFace"
                            android:layout_width="@dimen/_64sdp"
                            android:layout_height="@dimen/_64sdp"
                            android:visibility="gone">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivUploadedFace"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/SFS_RoundedCornerPhoto" />

                            <ImageView
                                android:id="@+id/ivRemoveFace"
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:layout_margin="@dimen/_3sdp"
                                android:background="@drawable/sfs_re_circle_face_dark_bg"
                                android:contentDescription="@null"
                                android:padding="@dimen/_4sdp"
                                android:src="@drawable/sfs_re_trans_close_choose" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Cost indicator -->
                <LinearLayout
                    android:id="@+id/llCostContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:background="@drawable/sfs_re_pill_face_solid_gradient"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_4sdp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:src="@drawable/sfs_face_re_coin_new" />

                    <TextView
                        android:id="@+id/tvFeatureCost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:fontFamily="@font/sfs_re_manrope_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_re_swap_ten_coins_text"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_45sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_14sdp"
                    android:background="@drawable/sfs_face_re_generate_button_square"
                    android:fontFamily="@font/sfs_re_manrope_semibold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:text="@string/sfs_re_swap_start_swapping_text"
                    android:textAllCaps="false"
                    android:textColor="@color/sfs_white"
                    android:textSize="@dimen/_15sdp"
                    app:backgroundTint="@null"
                    app:cornerRadius="18dp" />

            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/second_ad_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>
</RelativeLayout>
