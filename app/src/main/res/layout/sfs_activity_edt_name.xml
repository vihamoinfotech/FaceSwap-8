<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header (Same styling as Settings Header) -->
    <RelativeLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="@dimen/sfs_re_view_padding_horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/sfs_face_re_all_view_layer"

            android:padding="@dimen/_10sdp"
            android:scaleType="centerInside"
            android:src="@drawable/sfs_face_re_arw_back"
            app:tint="#1A1A2E" />

        <TextView
            style="@style/SFS_HeaderTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_toEndOf="@id/btnBack"
            android:includeFontPadding="false"
            android:text="@string/sfs_stngs_edt_name_title" />


    </RelativeLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/llHeader"
        android:background="@color/sfs_re_subtle_divider" />

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerDivider"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingTop="@dimen/_30sdp"
            android:paddingBottom="@dimen/_24sdp">

            <!-- Hero User Profile Initial Circle (Non-editable) -->
            <FrameLayout
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_gravity="center_horizontal">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/sfs_bkg_avatar_circle" />

                <TextView
                    android:id="@+id/tvHeroAvatarInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/sfs_re_manrope_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/sfs_re_primary_brand"
                    android:textSize="@dimen/_32sdp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvCurrentEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/sfs_re_manrope_regular"
                android:textColor="@color/sfs_re_secondary_text"
                android:textSize="@dimen/_11sdp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/_28sdp" />

            <!-- Field Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:fontFamily="@font/sfs_re_manrope_medium"
                android:includeFontPadding="false"
                android:text="@string/sfs_signup_full_name_hint"
                android:textColor="@color/sfs_text_tertiary"
                android:textSize="@dimen/_11sdp" />

            <!-- Edit Name Input -->
            <LinearLayout
                android:id="@+id/nameContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sfs_bkg_inpt_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_2sdp">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/sfs_face_re_rotation_face_swap_bg"
                    android:alpha="0.5" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_44sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/sfs_re_manrope_regular"
                    android:hint="@string/sfs_stngs_edt_name_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="yes"
                    android:includeFontPadding="false"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:textColor="#1A1A2E"
                    android:textColorHint="@color/sfs_text_tertiary"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/_13sdp" />

                <ImageView
                    android:id="@+id/btnClearName"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:contentDescription="@null"
                    android:padding="@dimen/_2sdp"
                    android:src="@drawable/sfs_re_trans_close_choose"
                    android:alpha="0.5"
                    android:visibility="gone"
                    app:tint="#1A1A2E" />
            </LinearLayout>

            <!-- Name Error -->
            <TextView
                android:id="@+id/tvNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/sfs_re_manrope_regular"
                android:includeFontPadding="false"
                android:textColor="@color/sfs_re_err_color"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone" />

            <!-- Spacer (expandable) -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Save Changes Button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24sdp">

                <TextView
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:background="@drawable/sfs_re_button_face_primary_bg"
                    android:elevation="6dp"
                    android:fontFamily="@font/sfs_re_manrope_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/sfs_re_lnguage_save_text"
                    android:textColor="@color/sfs_white"
                    android:textSize="@dimen/_14sdp" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/saveProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:elevation="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/sfs_white"
                    app:indicatorSize="@dimen/_22sdp"
                    app:trackColor="@android:color/transparent"
                    app:trackThickness="2.5dp" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
