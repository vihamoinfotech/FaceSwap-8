<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sfs_re_theme_dark_bkg">

    <RelativeLayout
        android:id="@+id/templateGalleryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="@dimen/sfs_re_view_padding_horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/sfs_face_re_all_view_layer"
                android:contentDescription="@string/sfs_face_re_back_text"
                android:padding="@dimen/_10sdp"
                android:scaleType="centerInside"
                android:src="@drawable/sfs_face_re_arw_back"
                app:tint="#1A1A2E" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                style="@style/SFS_HeaderTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_toEndOf="@id/btnBack"
                android:includeFontPadding="false"
                android:text="@string/sfs_re_template_gallery_title" />

            <!-- Coin balance pill -->
            <LinearLayout
                android:id="@+id/coinBalancePill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/sfs_re_pill_face_solid_gradient"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:contentDescription="@string/sfs_face_re_total_coin_balance_text"
                    android:src="@drawable/sfs_face_re_coin_new" />

                <TextView
                    android:id="@+id/tvCoinBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:fontFamily="@font/sfs_re_poppins_semibold"
                    android:includeFontPadding="false"
                    android:paddingEnd="@dimen/_2sdp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_14sdp" />
            </LinearLayout>
        </RelativeLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/llHeader"
            android:background="@color/sfs_re_subtle_divider" />

        <!-- Shimmer Loading -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/divider"
            android:layout_above="@+id/ad_view_container"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/sfs_re_shmr_main_category_view" />
                <include layout="@layout/sfs_re_shmr_main_category_view" />
                <include layout="@layout/sfs_re_shmr_main_category_view" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Error / Retry Container -->
        <LinearLayout
            android:id="@+id/llErrorRetryContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/divider"
            android:layout_above="@+id/ad_view_container"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_24sdp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sfs_re_poppins_bold"
                android:includeFontPadding="false"
                android:textColor="#1A1A2E"
                android:textSize="@dimen/_16sdp"
                tools:text="Could not load templates" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/sfs_re_poppins_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#666666"
                android:textSize="@dimen/_12sdp"
                tools:text="Please check your connection and try again" />

            <TextView
                android:id="@+id/btnRetryMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/sfs_face_re_dlog_button_gradient_horizontal"
                android:fontFamily="@font/sfs_re_poppins_semibold"
                android:includeFontPadding="false"
                android:paddingHorizontal="@dimen/_24sdp"
                android:paddingVertical="@dimen/_10sdp"
                android:text="@string/sfs_re_api_retry_button_text"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_12sdp" />
        </LinearLayout>

        <!-- Template Categories RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGalleryCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/ad_view_container"
            android:layout_below="@+id/divider"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone" />

        <!-- Bottom Ad -->
        <FrameLayout
            android:id="@+id/ad_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginVertical="@dimen/_2sdp" />

    </RelativeLayout>

</RelativeLayout>
