<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_theme_dark_background">

    <RelativeLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:paddingHorizontal="@dimen/app_screen_padding_horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/app_face_all_view_layer"
            android:contentDescription="@string/app_face_back_text"
            android:padding="@dimen/_10sdp"
            android:scaleType="centerInside"
            android:src="@drawable/app_face_arrow_back"
            app:tint="#1A1A2E" />

        <TextView
            style="@style/HeaderTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_toEndOf="@id/btnBack"
            android:includeFontPadding="false"
            android:text="@string/app_coin_store_text" />
    </RelativeLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_below="@+id/llHeader"
        android:layout_height="0dp"
        android:background="@color/app_subtle_divider" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnBuy"
        android:layout_below="@+id/divider"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <!-- Your Balance Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/app_store_balance_card_bg"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="20dp">

                <FrameLayout
                    android:layout_width="@dimen/_46sdp"
                    android:layout_height="@dimen/_46sdp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/app_circle_white_alpha" />

                    <ImageView
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/app_face_coin_new" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/app_poppins_regular"
                        android:letterSpacing="0.05"
                        android:text="YOUR BALANCE"
                        android:includeFontPadding="false"
                        android:textColor="#E0E7FF"
                        android:textSize="@dimen/_11sdp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTotalCoins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/app_poppins_bold"
                            android:text="0"
                            android:includeFontPadding="false"
                            android:textColor="@color/app_yellow_coin"
                            android:textSize="@dimen/_24sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:fontFamily="@font/app_poppins_semibold"
                            android:text="Credits"
                            android:textColor="#FFFFFF"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/_15sdp"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Choose a Package Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="@dimen/_3sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:background="@drawable/app_face_badge_best_value_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/app_poppins_bold"
                        android:text="Choose a Package"
                        android:includeFontPadding="false"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_14sdp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/app_poppins_regular"
                    android:text="Instant delivery • Secure payment via Google Play"
                    android:textColor="@color/app_secondary_text"
                    android:includeFontPadding="false"
                    android:textSize="@dimen/_9sdp" />
            </LinearLayout>

            <!-- Package Plans RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
    </ScrollView>

    <!-- Buy Now Button -->
    <TextView
        android:id="@+id/btnBuy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/securedBadge"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/app_buy_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:includeFontPadding="false"
        android:fontFamily="@font/app_poppins_bold"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:text="@string/store_buy_now"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_16sdp" />

    <!-- Secured badge -->
    <LinearLayout
        android:id="@+id/securedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/app_face_secure_locker"
            app:tint="@color/app_yellow_coin" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/app_poppins_regular"
            android:text="Secured by Google Play"
            android:textColor="@color/app_tertiary_text"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Retry/Error overlay (centered) -->
    <LinearLayout
        android:id="@+id/llRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/app_poppins_medium"
            android:gravity="center"
            android:text="@string/app_face_coins_fetching_offerings_error_text"
            android:textColor="@color/app_secondary_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/app_buy_button_bg"
            android:fontFamily="@font/app_poppins_bold"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="@string/app_face_ai_coins_retry_text"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>
