<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sfs_re_theme_dark_bkg">

    <RelativeLayout
        android:id="@+id/textToImageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="@dimen/sfs_re_view_padding_horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/sfs_face_re_all_view_layer"
                android:contentDescription="@string/sfs_face_re_back_text"
                android:padding="@dimen/_10sdp"
                android:scaleType="centerInside"
                android:src="@drawable/sfs_face_re_arw_back"
                app:tint="#1A1A2E" />

            <TextView
                style="@style/SFS_HeaderTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_toEndOf="@id/btnBack"
                android:text="@string/sfs_re_text_to_image_text" />
        </RelativeLayout>

        <View
            android:id="@+id/underline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@id/llHeader"
            android:background="@color/sfs_re_subtle_divider" />

        <!-- Generate button (fixed bottom) -->
        <!-- Cost indicator -->
        <LinearLayout
            android:id="@+id/llCostContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/btnGenerate"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/_6sdp"
            android:background="@drawable/sfs_re_pill_face_solid_gradient"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/sfs_re_view_padding_horizontal"
            android:paddingVertical="@dimen/_4sdp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/sfs_face_re_coin_new" />

            <TextView
                android:id="@+id/tvFeatureCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/sfs_re_manrope_semibold"
                android:includeFontPadding="false"
                android:text="@string/sfs_ai_face_image_10_coins_text"
                android:textColor="#1A1A2E"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:layout_above="@+id/second_ad_view_container"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_14sdp"
            android:background="@drawable/sfs_face_re_generate_button_square"
            android:fontFamily="@font/sfs_re_manrope_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="@string/sfs_ai_face_image_generate_image_text"
            android:textAllCaps="false"
            android:textColor="@color/sfs_white"
            android:textSize="@dimen/_15sdp"
            app:backgroundTint="@null"
            app:cornerRadius="18dp" />

        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/btnGenerate"
            android:layout_below="@id/underline"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingTop="@dimen/_18sdp"
                android:paddingBottom="@dimen/_12sdp">

                <!-- Headline -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sfs_re_manrope_bold"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_ai_face_image_text_to_text"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_22sdp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sfs_re_manrope_extrabold"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_ai_face_image_text"
                        android:textColor="@color/sfs_re_primary_brand"
                        android:textSize="@dimen/_22sdp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:fontFamily="@font/sfs_re_manrope_regular"
                    android:includeFontPadding="false"
                    android:text="@string/sfs_ai_face_image_describe_anything_and_watch_text"
                    android:textColor="@color/sfs_re_tertiary_text"
                    android:textSize="@dimen/_11sdp" />

                <!-- Prompt section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:background="@drawable/sfs_face_re_common_border_color"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_20sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_20sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/sfs_re_icon_container_size"
                            android:layout_height="@dimen/sfs_re_icon_container_size"
                            android:background="@drawable/sfs_face_re_bfge_orange_gradient_bg"
                            android:contentDescription="@null"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/sfs_re_to_text_prompt_toggle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/sfs_re_manrope_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/sfs_re_your_prompt_text"
                                android:textColor="#1A1A2E"
                                android:textSize="@dimen/_14sdp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/sfs_re_manrope_regular"
                                android:includeFontPadding="false"
                                android:text="@string/sfs_re_be_descriptive_for_best_text"
                                android:textColor="@color/sfs_re_tertiary_text"
                                android:textSize="@dimen/_9sdp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/sfs_face_re_bfge_orange_gradient_bg"
                            android:fontFamily="@font/sfs_re_manrope_semibold"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="@dimen/_9sdp"
                            android:paddingVertical="@dimen/_3sdp"
                            android:text="@string/sfs_face_re_required_text"
                            android:textColor="#1A1A2E"
                            android:textSize="@dimen/_8sdp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/sfs_re_clear_bkg_only_light_border"
                        android:fontFamily="@font/sfs_re_manrope_regular"
                        android:gravity="top|start"
                        android:hint="e.g. A warrior princess in enchanted forest, cinematic lighting, 8K..."
                        android:includeFontPadding="false"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineSpacingMultiplier="1.4"
                        android:minHeight="@dimen/_140sdp"
                        android:padding="@dimen/_12sdp"
                        android:textColor="#1A1A2E"
                        android:textColorHint="@color/sfs_re_disabled_text"
                        android:textSize="@dimen/_13sdp" />
                </LinearLayout>

                <!-- Suggestions section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sfs_face_re_common_border_color"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_20sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_16sdp"
                        android:fontFamily="@font/sfs_re_manrope_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_re_quick_ideas_text"
                        android:textColor="@color/sfs_re_secondary_text"
                        android:textSize="@dimen/_12sdp" />

                    <!-- Chip suggestions — populated programmatically -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:id="@+id/chipSuggestions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="@dimen/_2sdp" />
                    </HorizontalScrollView>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/second_ad_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

</RelativeLayout>
