<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/mainActContent"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingStart="17dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sfs_re_jakarta_bold"
                    android:includeFontPadding="false"
                    android:text="@string/sfs_re_home_brand"
                    android:textColor="#18243E"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/sfs_re_jakarta_medium"
                    android:includeFontPadding="false"
                    android:text="@string/sfs_re_home_brand_subtitle"
                    android:textColor="#758096"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/coinBalancePill"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/sfs_re_home_v2_coin"
                    android:clickable="true"
                    android:contentDescription="@string/sfs_face_re_total_coin_balance_text"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minWidth="70dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_coin_new" />

                    <TextView
                        android:id="@+id/tvCoinBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:fontFamily="@font/sfs_re_jakarta_extrabold"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="#443008"
                        android:textSize="@dimen/_13sdp"
                        android:textStyle="bold" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/sfs_re_home_v2_settings"
                    android:clickable="true"
                    android:contentDescription="@string/sfs_face_re_stngs_text"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_stngs_header_wheel"
                        app:tint="#34425C" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>

        <FrameLayout
            android:id="@+id/ad_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/second_ad_view_container"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="28dp">

<!--                    <TextView-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_marginStart="17dp"-->
<!--                        android:layout_marginTop="13dp"-->
<!--                        android:layout_marginEnd="17dp"-->
<!--                        android:fontFamily="@font/sfs_re_jakarta_bold"-->
<!--                        android:includeFontPadding="false"-->
<!--                        android:text="@string/sfs_re_home_heading"-->
<!--                        android:textColor="#18243E"-->
<!--                        android:textSize="23sp"-->
<!--                        android:textStyle="bold" />-->

<!--                    <TextView-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_marginStart="17dp"-->
<!--                        android:layout_marginTop="3dp"-->
<!--                        android:layout_marginEnd="17dp"-->
<!--                        android:fontFamily="@font/sfs_re_jakarta_regular"-->
<!--                        android:includeFontPadding="false"-->
<!--                        android:text="@string/sfs_re_home_heading_subtitle"-->
<!--                        android:textColor="#6A778D"-->
<!--                        android:textSize="12sp" />-->

                    <include layout="@layout/sfs_re_dash_header_view" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btnAiCreate"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/sfs_re_home_v2_ai"
                            android:clickable="true"
                            android:contentDescription="@string/sfs_re_dash_ai_create_cta"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <FrameLayout
                                android:id="@+id/aiCreateIconTile"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/sfs_re_home_v3_ai_icon">
                                <ImageView
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/sfs_face_re_generative_chat_ai"
                                    app:tint="#FFFFFF" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/SFS_HomeV2ToolTitle"
                                    android:id="@+id/tvHomeAiTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="0dp"
                                    android:includeFontPadding="false"
                                    android:text="@string/sfs_re_dash_ai_create_cta"
                                    android:textColor="#302862" />
                                <TextView
                                    style="@style/SFS_HomeV2ToolSubtitle"

                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:includeFontPadding="false"
                                    android:maxLines="2"
                                    android:text="@string/sfs_re_home_ai_subtitle"
                                    android:textColor="#7369A1" />
                            </LinearLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:id="@+id/cardExploreTemplates"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/sfs_re_home_v2_templates"
                            android:clickable="true"
                            android:contentDescription="@string/sfs_re_dash_explore_templates"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/ivTemplateIcon"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/sfs_re_home_v3_template_icon"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/sfs_ic_explore_templates"
                                app:tint="#FFFFFF" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/SFS_HomeV2ToolTitle"
                                    android:id="@+id/tvHomeTemplatesTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="0dp"
                                    android:includeFontPadding="false"
                                    android:text="@string/sfs_re_home_templates_title"
                                    android:textColor="#604514" />
                                <TextView
                                    style="@style/SFS_HomeV2ToolSubtitle"

                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:includeFontPadding="false"
                                    android:maxLines="2"
                                    android:text="@string/sfs_re_home_templates_subtitle"
                                    android:textColor="#8A6A30" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

<!--                    <TextView-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_marginStart="17dp"-->
<!--                        android:layout_marginTop="16dp"-->
<!--                        android:background="@drawable/sfs_re_home_v3_section_pill"-->
<!--                        android:fontFamily="@font/sfs_re_jakarta_medium"-->
<!--                        android:includeFontPadding="false"-->
<!--                        android:letterSpacing="0.08"-->
<!--                        android:paddingHorizontal="10dp"-->
<!--                        android:paddingVertical="5dp"-->
<!--                        android:text="@string/sfs_re_home_tools_badge"-->
<!--                        android:textColor="#5A48B5"-->
<!--                        android:textSize="9sp" />-->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="17dp"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:layout_marginEnd="17dp"
                        android:fontFamily="@font/sfs_re_jakarta_extrabold"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_re_dash_quick_actions"
                        android:textColor="#18243E"
                        android:textSize="@dimen/_18sdp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="17dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="17dp"
                        android:layout_marginBottom="7dp"
                        android:fontFamily="@font/sfs_re_jakarta_regular"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_re_home_tools_subtitle"
                        android:textColor="#6A778D"
                        android:textSize="@dimen/_9sdp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_marginEnd="11dp"
                        android:columnCount="2"
                        android:rowCount="2">

                        <FrameLayout
                            android:id="@+id/cardVideoSwap"
                            style="@style/SFS_HomeV2ToolCard"
                            android:background="@drawable/sfs_re_home_v3_card_video"
                            android:contentDescription="@string/sfs_re_home_video_premium">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">
                                <FrameLayout
                                    style="@style/SFS_HomeV2IconFrame"
                                    android:background="@drawable/sfs_re_home_v2_icon_video">
                                    <ImageView
                                        style="@style/SFS_HomeV2Icon"
                                        android:src="@drawable/sfs_face_re_mov_reverse_eng"
                                        app:tint="#FFFFFF" />
                                </FrameLayout>
                                <TextView
                                    style="@style/SFS_HomeV2ToolTitle"
                                    android:text="@string/sfs_re_dash_mov_swap"
                                    android:layout_marginTop="@dimen/_7sdp"
                                    android:textColor="#68344A" />
                                <TextView
                                    style="@style/SFS_HomeV2ToolSubtitle"
                                    android:text="@string/sfs_re_home_video_subtitle"
                                    android:textColor="#8F5B72" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/sfs_re_home_v3_premium_badge"
                                android:fontFamily="@font/sfs_re_jakarta_bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="9dp"
                                android:text="@string/sfs_re_home_premium_badge"
                                android:textColor="#4D3004"
                                android:textSize="9sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/cardRemoveBg"
                            style="@style/SFS_HomeV2ToolCard"
                            android:background="@drawable/sfs_re_home_v3_card_remove"
                            android:contentDescription="@string/sfs_re_dash_rmv_bg">
                            <FrameLayout
                                style="@style/SFS_HomeV2IconFrame"
                                android:background="@drawable/sfs_re_home_v2_icon_remove">
                                <ImageView
                                    style="@style/SFS_HomeV2Icon"
                                    android:src="@drawable/sfs_ic_rmv_bg"
                                    app:tint="#FFFFFF" />
                            </FrameLayout>
                            <TextView
                                style="@style/SFS_HomeV2ToolTitle"
                                android:text="@string/sfs_re_dash_rmv_bg"
                                android:layout_marginTop="@dimen/_7sdp"

                                android:textColor="#134E50" />
                            <TextView
                                style="@style/SFS_HomeV2ToolSubtitle"
                                android:text="@string/sfs_re_home_remove_subtitle"
                                android:textColor="#3F706D" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardEnhanceFace"
                            style="@style/SFS_HomeV2ToolCard"
                            android:background="@drawable/sfs_re_home_v3_card_enhance"
                            android:contentDescription="@string/sfs_re_dash_enhance_face">
                            <FrameLayout
                                style="@style/SFS_HomeV2IconFrame"
                                android:background="@drawable/sfs_re_home_v2_icon_enhance">
                                <ImageView
                                    style="@style/SFS_HomeV2Icon"
                                    android:src="@drawable/sfs_ic_enhance_face"
                                    app:tint="#FFFFFF" />
                            </FrameLayout>
                            <TextView
                                style="@style/SFS_HomeV2ToolTitle"
                                android:text="@string/sfs_re_dash_enhance_face"
                                android:layout_marginTop="@dimen/_7sdp"

                                android:textColor="#683C2B" />
                            <TextView
                                style="@style/SFS_HomeV2ToolSubtitle"
                                android:text="@string/sfs_re_home_enhance_subtitle"
                                android:textColor="#805C4C" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardMyWork"
                            style="@style/SFS_HomeV2ToolCard"
                            android:background="@drawable/sfs_re_home_v3_card_work"
                            android:contentDescription="@string/sfs_re_dash_my_work">
                            <FrameLayout
                                style="@style/SFS_HomeV2IconFrame"
                                android:background="@drawable/sfs_re_home_v2_icon_work">
                                <ImageView
                                    style="@style/SFS_HomeV2Icon"
                                    android:src="@drawable/sfs_face_re_my_work_four"
                                    app:tint="#FFFFFF" />
                            </FrameLayout>
                            <TextView
                                style="@style/SFS_HomeV2ToolTitle"
                                android:text="@string/sfs_re_dash_my_work"
                                android:layout_marginTop="@dimen/_7sdp"

                                android:textColor="#353B70" />
                            <TextView
                                style="@style/SFS_HomeV2ToolSubtitle"
                                android:text="@string/sfs_re_home_work_subtitle"
                                android:textColor="#5C6695" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </ScrollView>

            <FrameLayout
                android:id="@+id/second_ad_view_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
