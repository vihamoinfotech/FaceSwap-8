<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_theme_dark_background">

    <RelativeLayout
        android:id="@+id/bgReplaceContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="@dimen/_6sdp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/app_face_all_view_layer"
                android:contentDescription="@string/app_face_back_text"
                android:padding="@dimen/_10sdp"
                android:scaleType="centerInside"
                android:src="@drawable/app_face_arrow_back"
                app:tint="@color/white" />

            <TextView
                style="@style/HeaderTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_toEndOf="@id/btnBack"
                android:text="@string/app_face_background_replace_text" />
        </RelativeLayout>

        <View
            android:id="@+id/underline"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/llHeader"
            android:background="@color/app_subtle_divider" />

        <!-- Generate button (fixed bottom) -->
        <!-- Cost indicator -->
        <LinearLayout
            android:id="@+id/llCostContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/btnGenerate"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/_6sdp"
            android:background="@drawable/app_pill_face_solid_gradient"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/app_face_coin_new" />

            <TextView
                android:id="@+id/tvFeatureCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/app_poppins_semibold"
                android:includeFontPadding="false"
                android:text="@string/app_face_replace_10_coins_text"
                android:textColor="@color/white"
                android:textSize="@dimen/_10sdp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:layout_above="@+id/second_ad_view_container"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_14sdp"
            android:background="@drawable/app_face_generate_button_square"
            android:fontFamily="@font/app_poppins_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="@string/app_face_replace_background_text"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_15sdp"
            app:backgroundTint="@null"
            app:cornerRadius="16dp" />

        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/btnGenerate"
            android:layout_below="@id/underline"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingTop="@dimen/_18sdp"
                android:paddingBottom="@dimen/_12sdp">

                <!-- Headline -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/app_poppins_bold"
                        android:includeFontPadding="false"
                        android:text="@string/app_face_replace_text"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_20sdp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/app_poppins_extrabold"
                        android:includeFontPadding="false"
                        android:text="@string/app_face_only_background_text"
                        android:textColor="@color/app_primary_brand"
                        android:textSize="@dimen/_20sdp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:fontFamily="@font/app_poppins_regular"
                    android:includeFontPadding="false"
                    android:text="@string/app_face_replace_upload_a_photo_text"
                    android:textColor="@color/app_tertiary_text"
                    android:textSize="@dimen/_11sdp" />

                <!-- Step 1: Upload photo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:background="@drawable/app_face_common_border_color"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:background="@drawable/app_face_badge_orange_gradient_bg"
                            android:contentDescription="@null"
                            android:padding="@dimen/_7sdp"
                            android:src="@drawable/app_middle_face_upload" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/app_poppins_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/app_face_replace_your_photo_text"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_13sdp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/app_poppins_regular"
                                android:includeFontPadding="false"
                                android:text="@string/app_face_replace_subject_should_be_clearly_text"
                                android:textColor="@color/app_tertiary_text"
                                android:textSize="@dimen/_9sdp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/app_face_badge_orange_gradient_bg"
                            android:fontFamily="@font/app_poppins_semibold"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="@dimen/_9sdp"
                            android:paddingVertical="@dimen/_3sdp"
                            android:text="@string/app_replace_step_1_text"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_8sdp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/framePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:visibility="gone">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPreview"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_220sdp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCornerImage" />

                        <ImageView
                            android:id="@+id/ivRemove"
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:layout_gravity="top|end"
                            android:layout_margin="@dimen/_8sdp"
                            android:background="@drawable/app_face_all_view_layer"
                            android:contentDescription="@null"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/app_transparent_close_choose"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/llUploadContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:background="@drawable/app_face_dashed_border_purple"
                        android:gravity="center"
                        android:minHeight="@dimen/_180sdp"
                        android:orientation="vertical"
                        android:padding="@dimen/_20sdp">

                        <ImageView
                            android:layout_width="@dimen/_44sdp"
                            android:layout_height="@dimen/_44sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/app_face_choose_image" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:fontFamily="@font/app_poppins_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/app_face_replace_tap_to_upload_your_text"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_13sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/app_poppins_regular"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/app_face_replace_any_photo_with_text"
                            android:textColor="@color/app_tertiary_text"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/ad_view_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_1sdp"
                        android:layout_marginTop="@dimen/_6sdp" />
                </LinearLayout>

                <!-- Step 2: Describe background -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/app_face_common_border_color"
                    android:orientation="vertical"
                    android:padding="@dimen/_16sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_32sdp"
                            android:background="@drawable/app_face_badge_orange_gradient_bg"
                            android:contentDescription="@null"
                            android:padding="@dimen/_7sdp"
                            android:src="@drawable/app_to_text_prompt_toggle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/app_poppins_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/app_face_replace_describe_new_background_text"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_13sdp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/app_poppins_regular"
                                android:includeFontPadding="false"
                                android:text="@string/app_face_replace_be_descriptive_for_best_text"
                                android:textColor="@color/app_tertiary_text"
                                android:textSize="@dimen/_9sdp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/app_face_badge_orange_gradient_bg"
                            android:fontFamily="@font/app_poppins_semibold"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="@dimen/_9sdp"
                            android:paddingVertical="@dimen/_3sdp"
                            android:text="@string/app_face_replace_step_2_text"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_8sdp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/app_clear_bg_only_light_border"
                        android:fontFamily="@font/app_poppins_regular"
                        android:gravity="top|start"
                        android:hint="e.g. Sunset beach, city skyline at night, lush forest..."
                        android:includeFontPadding="false"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineSpacingMultiplier="1.4"
                        android:minHeight="@dimen/_100sdp"
                        android:padding="@dimen/_12sdp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/app_disabled_text"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/second_ad_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

</RelativeLayout>
