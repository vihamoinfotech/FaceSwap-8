<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bannerCreateAi"
    android:layout_width="match_parent"
    android:layout_height="184dp"
    android:layout_marginStart="16dp"
    android:layout_marginTop="14dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp">

    <FrameLayout
        android:id="@+id/btnFaceSwap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/sfs_re_home_v2_hero"
        android:clickable="true"
        android:clipToOutline="true"
        android:contentDescription="@string/sfs_re_home_start_face_swap"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <View
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-48dp"
            android:layout_marginEnd="-30dp"
            android:background="@drawable/sfs_re_home_v2_hero_orb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="112dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sfs_re_jakarta_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="@string/sfs_re_home_featured_label"
                android:textColor="#FFC5B5"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/sfs_re_jakarta_bold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-2dp"
                android:text="@string/sfs_re_home_hero_title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/sfs_re_jakarta_regular"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/sfs_re_home_hero_subtitle"
                android:textColor="#E3E9F6"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/sfs_re_home_v2_hero_cta"
                android:drawableEnd="@drawable/sfs_re_home_v2_arrow"
                android:drawablePadding="9dp"
                android:fontFamily="@font/sfs_re_jakarta_bold"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:minHeight="34dp"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:text="@string/sfs_re_home_start_face_swap"
                android:textColor="#17233E"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="21dp"
            android:background="@drawable/sfs_re_home_v2_hero_icon_bg">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/sfs_face_re_rotation_face_swap_bg"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/ivSparkle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="92dp"
            android:text="✦"
            android:textColor="#FFA96A"
            android:textSize="22sp" />
    </FrameLayout>
</FrameLayout>
