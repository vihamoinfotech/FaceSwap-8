<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sfs_re_theme_dark_bkg">

    <RelativeLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ═══════════════════════════════════════════ -->
        <!-- Header bar -->
        <RelativeLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:layout_alignParentTop="true"
            android:paddingHorizontal="@dimen/_16sdp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/sfs_face_re_all_view_layer"
                android:contentDescription="@string/sfs_face_re_back_text"
                android:padding="@dimen/_10sdp"
                android:scaleType="centerInside"
                android:src="@drawable/sfs_face_re_arw_back"
                app:tint="#1A1A2E" />

            <TextView
                style="@style/SFS_HeaderTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_toEndOf="@id/btnBack"
                android:includeFontPadding="false"
                android:text="@string/sfs_re_stngs_text" />
        </RelativeLayout>

        <!-- Hidden underline — kept for ID reference -->
        <View
            android:id="@+id/underLine"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/llHeader" />

        <FrameLayout
            android:id="@+id/ad_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:paddingVertical="@dimen/_2sdp" />

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/ad_view_container"
            android:layout_below="@+id/underLine"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/_30sdp">

                <!-- ═══════════════════════════════════════════ -->
                <!-- ACCOUNT SECTION -->
                <!-- ═══════════════════════════════════════════ -->
                <TextView
                    android:id="@+id/sectionAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:layout_marginStart="@dimen/_22sdp"
                    style="@style/SFS_SectionLabelStyle"
                    android:text="@string/sfs_stngs_account"
                    android:visibility="gone" />

                <!-- ═══════════════════════════════════════════ -->
                <!-- PROFILE BANNER — Full-width gradient card -->
                <!-- ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/accountGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Profile Card with gradient background -->
                    <LinearLayout
                        android:id="@+id/llUserProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/sfs_re_stngs_profile_card_bg"
                        android:elevation="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_24sdp"
                        android:paddingVertical="@dimen/_28sdp"
                        android:layout_marginBottom="@dimen/_16sdp">

                        <!-- Large Avatar -->
                        <FrameLayout
                            android:layout_width="@dimen/_68sdp"
                            android:layout_height="@dimen/_68sdp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/sfs_bkg_avatar_circle" />

                            <TextView
                                android:id="@+id/tvAvatarInitial"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/sfs_re_poppins_bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_26sdp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_18sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvProfileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/sfs_re_poppins_bold"
                                android:includeFontPadding="false"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_20sdp" />

                            <TextView
                                android:id="@+id/tvProfileEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:fontFamily="@font/sfs_re_poppins_regular"
                                android:includeFontPadding="false"
                                android:textColor="#99FFFFFF"
                                android:textSize="@dimen/_11sdp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Edit Name -->
                    <LinearLayout
                        android:id="@+id/llEditName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_58sdp"
                        android:background="@drawable/sfs_face_re_common_border_color"
                        android:elevation="8dp"
                    android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_18sdp"
                        android:layout_marginBottom="@dimen/_16sdp">

                        <ImageView
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/sfs_face_re_edt_go"
                            app:tint="@color/sfs_re_primary_brand" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_16sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/sfs_re_poppins_medium"
                            android:includeFontPadding="false"
                            android:text="@string/sfs_stngs_edt_name"
                            android:textColor="#1A1A2E"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:alpha="0.3"
                            android:contentDescription="@null"
                            android:src="@drawable/sfs_face_re_arw_right"
                            app:tint="#1A1A2E" />
                    </LinearLayout>

                    <!-- Logout -->
                    <LinearLayout
                        android:id="@+id/llLogout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_58sdp"
                        android:background="@drawable/sfs_face_re_common_border_color"
                        android:elevation="8dp"
                    android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_18sdp"
                        android:layout_marginBottom="@dimen/_16sdp">

                        <ImageView
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/sfs_logout"
                            app:tint="@color/sfs_re_primary_brand" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_16sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/sfs_re_poppins_medium"
                            android:includeFontPadding="false"
                            android:text="@string/sfs_stngs_logout"
                            android:textColor="#1A1A2E"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:alpha="0.3"
                            android:contentDescription="@null"
                            android:src="@drawable/sfs_face_re_arw_right"
                            app:tint="#1A1A2E" />
                    </LinearLayout>

                    <!-- Delete Account -->
                    <LinearLayout
                        android:id="@+id/llDeleteAccount"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_58sdp"
                        android:background="@drawable/sfs_face_re_common_border_color"
                        android:elevation="8dp"
                    android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_18sdp">

                        <ImageView
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/sfs_delete_account"
                            app:tint="#FF5C7A" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_16sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/sfs_re_poppins_medium"
                            android:includeFontPadding="false"
                            android:text="@string/sfs_stngs_delete_account"
                            android:textColor="#FF5C7A"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:alpha="0.3"
                            android:contentDescription="@null"
                            android:src="@drawable/sfs_face_re_arw_right"
                            app:tint="#FF5C7A" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ═══════════════════════════════════════════ -->
                <!-- PREMIUM CARD — Hero gradient banner -->
                <!-- ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/coinsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_18sdp"
                    android:orientation="vertical">

                    <!-- Coin History -->
                    <LinearLayout
                        android:id="@+id/llCoinHistory"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_58sdp"
                        android:background="@drawable/sfs_face_re_common_border_color"
                        android:elevation="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_18sdp"
                        android:layout_marginBottom="@dimen/_16sdp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/sfs_face_re_coin_new" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_16sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/sfs_re_poppins_medium"
                            android:includeFontPadding="false"
                            android:text="@string/sfs_re_coin_history_text"
                            android:textColor="#1A1A2E"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:alpha="0.3"
                            android:contentDescription="@null"
                            android:src="@drawable/sfs_face_re_arw_right"
                            app:tint="#1A1A2E" />
                    </LinearLayout>

                    <!-- Unlock Premium — Big hero horizontal card -->
                    <LinearLayout
                        android:id="@+id/llBuyCoins"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_6sdp"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:background="@drawable/sfs_re_stngs_premium_banner_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:elevation="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_20sdp"
                        android:paddingVertical="@dimen/_22sdp">

                        <!-- Diamond icon in a frosted white circle -->
                        <FrameLayout
                            android:layout_width="@dimen/_52sdp"
                            android:layout_height="@dimen/_52sdp"
                            android:background="@drawable/sfs_face_re_frosted_circle_bg">

                            <ImageView
                                android:layout_width="@dimen/_28sdp"
                                android:layout_height="@dimen/_28sdp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/sfs_face_re_diamond_premium"
                                android:scaleType="centerInside"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <!-- Text block -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_16sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/sfs_re_poppins_bold"
                                android:includeFontPadding="false"
                                android:text="Unlock Premium"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_16sdp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:fontFamily="@font/sfs_re_poppins_regular"
                                android:includeFontPadding="false"
                                android:text="Unlimited swaps, no ads &amp; more"
                                android:textColor="#CCE0E7FF"
                                android:textSize="@dimen/_10sdp" />
                        </LinearLayout>

                        <!-- Gold Upgrade CTA pill -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:background="@drawable/sfs_re_stngs_upgrade_pill_bg"
                            android:fontFamily="@font/sfs_re_poppins_bold"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="@dimen/_14sdp"
                            android:paddingVertical="@dimen/_8sdp"
                            android:text="Get Pro"
                            android:textColor="#FFFFFF"
                            android:visibility="gone"
                            android:textSize="@dimen/_11sdp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- ═══════════════════════════════════════════ -->
                <!-- APP SECTION -->
                <!-- ═══════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:layout_marginStart="@dimen/_22sdp"
                    style="@style/SFS_SectionLabelStyle"
                    android:text="APP" />

                <!-- Language -->
                <LinearLayout
                    android:id="@+id/llLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_58sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:background="@drawable/sfs_face_re_common_border_color"
                    android:elevation="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_18sdp">

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_re_lnguage_iconic"
                        app:tint="@color/sfs_re_primary_brand" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/sfs_re_poppins_medium"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_face_re_lnguage_text"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_14sdp" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:alpha="0.3"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_arw_right"
                        app:tint="#1A1A2E" />
                </LinearLayout>

                <!-- Feedback -->
                <LinearLayout
                    android:id="@+id/llFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_58sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:background="@drawable/sfs_face_re_common_border_color"
                    android:elevation="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_18sdp">

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_feedback_chat"
                        app:tint="@color/sfs_re_primary_brand" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/sfs_re_poppins_medium"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_face_re_feedback_text"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_14sdp" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:alpha="0.3"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_arw_right"
                        app:tint="#1A1A2E" />
                </LinearLayout>

                <!-- Share App -->
                <LinearLayout
                    android:id="@+id/llShareApp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_58sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:background="@drawable/sfs_face_re_common_border_color"
                    android:elevation="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_18sdp">

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_share_ref"
                        app:tint="@color/sfs_re_primary_brand" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/sfs_re_poppins_medium"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_face_re_share_re_text"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_14sdp" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:alpha="0.3"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_arw_right"
                        app:tint="#1A1A2E" />
                </LinearLayout>

                <!-- Rate App -->
                <LinearLayout
                    android:id="@+id/llRateApp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_58sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_28sdp"
                    android:background="@drawable/sfs_face_re_common_border_color"
                    android:elevation="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_18sdp">

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_rating_chat"
                        app:tint="@color/sfs_re_primary_brand" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/sfs_re_poppins_medium"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_face_re_rate_re_text"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_14sdp" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:alpha="0.3"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_arw_right"
                        app:tint="#1A1A2E" />
                </LinearLayout>

                <!-- ═══════════════════════════════════════════ -->
                <!-- LEGAL SECTION -->
                <!-- ═══════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:layout_marginStart="@dimen/_22sdp"
                    style="@style/SFS_SectionLabelStyle"
                    android:text="@string/sfs_face_re_legal_text" />

                <!-- Terms -->
                <LinearLayout
                    android:id="@+id/llTerms"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_58sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:background="@drawable/sfs_face_re_common_border_color"
                    android:elevation="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_18sdp">

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_terms_conditions"
                        app:tint="@color/sfs_re_primary_brand" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/sfs_re_poppins_medium"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_re_terms_and_conditions_text"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_14sdp" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:alpha="0.3"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_arw_right"
                        app:tint="#1A1A2E" />
                </LinearLayout>

                <!-- Privacy Policy -->
                <LinearLayout
                    android:id="@+id/llPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_58sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:background="@drawable/sfs_face_re_common_border_color"
                    android:elevation="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_18sdp">

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/sfs_face_re_privacy"
                        app:tint="@color/sfs_re_primary_brand" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/sfs_re_poppins_medium"
                        android:includeFontPadding="false"
                        android:text="@string/sfs_re_privacy_policy_text"
