<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_theme_dark_background">

    <LinearLayout
        android:id="@+id/editImageContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:paddingHorizontal="@dimen/app_screen_padding_horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/app_face_all_view_layer"
                android:contentDescription="@string/app_face_back_text"
                android:padding="@dimen/_10sdp"
                android:scaleType="centerInside"
                android:src="@drawable/app_face_arrow_back"
                app:tint="#1A1A2E" />

            <TextView
                style="@style/HeaderTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:includeFontPadding="false"
                android:text="@string/app_edit_image_text" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnDownload"
                    android:layout_width="@dimen/_38sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:background="@drawable/app_face_all_view_layer"
                    android:contentDescription="Download"
                    android:padding="@dimen/_10sdp"
                    android:scaleType="centerInside"
                    android:src="@drawable/app_face_download_icon"
                    android:layout_marginEnd="@dimen/_8sdp"
                    app:tint="#1A1A2E" />

                <ImageView
                    android:id="@+id/btnUndo"
                    android:layout_width="@dimen/_38sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:background="@drawable/app_face_all_view_layer"
                    android:contentDescription="Undo"
                    android:padding="@dimen/_10sdp"
                    android:scaleType="centerInside"
                    android:src="@drawable/app_face_undo_rotate"
                    android:visibility="gone"
                    app:tint="#1A1A2E" />
            </LinearLayout>
        </RelativeLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/app_subtle_divider" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Bottom toolbar -->
                <LinearLayout
                    android:id="@+id/llBottomBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignWithParentIfMissing="true"
                    android:layout_above="@+id/ad_view_container"
                    android:background="@color/app_elevated_surface"
                    android:elevation="8dp"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/_10sdp"
                    android:paddingHorizontal="@dimen/_8sdp">

                    <!-- Remove BG -->
                    <LinearLayout
                        android:id="@+id/btnChangeBG1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_4sdp">

                        <LinearLayout
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:background="@drawable/app_face_badge_orange_gradient_bg"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:contentDescription="@null"
                                android:src="@drawable/app_face_eraser_icon" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:fontFamily="@font/app_poppins_medium"
                            android:includeFontPadding="false"
                            android:text="@string/app_image_remove_bg_text"
                            android:textColor="#1A1A2E"
                            android:textSize="@dimen/_9sdp" />

                    </LinearLayout>

                    <!-- Change BG (hidden by default) -->
                    <LinearLayout
                        android:id="@+id/btnChangeBG2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_4sdp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="@dimen/_44sdp"
                            android:layout_height="@dimen/_44sdp"
                            android:background="@drawable/app_face_badge_orange_gradient_bg"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="@dimen/_22sdp"
                                android:layout_height="@dimen/_22sdp"
                                android:contentDescription="@null"
                                android:src="@drawable/app_face_change_round" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:fontFamily="@font/app_poppins_medium"
                            android:includeFontPadding="false"
                            android:text="@string/app_edit_change_bg_text"
                            android:textColor="#1A1A2E"
                            android:textSize="@dimen/_9sdp" />
                    </LinearLayout>

                    <!-- Enhance -->
                    <LinearLayout
                        android:id="@+id/btnChangeBG3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_4sdp">

                        <LinearLayout
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:background="@drawable/app_face_badge_orange_gradient_bg"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:contentDescription="@null"
                                android:src="@drawable/app_face_enhance_image" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:fontFamily="@font/app_poppins_medium"
                            android:includeFontPadding="false"
                            android:text="@string/app_image_enhance_text"
                            android:textColor="#1A1A2E"
                            android:textSize="@dimen/_9sdp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Image preview fills space above toolbar -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivEditPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/llBottomBar"
                    android:layout_alignParentTop="true"
                    android:layout_margin="@dimen/_14sdp"
                    android:scaleType="fitCenter"
                    app:shapeAppearanceOverlay="@style/RoundedCornerImage" />

                <FrameLayout
                    android:id="@+id/ad_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:paddingVertical="@dimen/_2sdp" />
            </RelativeLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/loaderOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0A14"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/app_primary_brand"
            app:indicatorSize="48dp"
            app:trackColor="@color/app_soft_border"
            app:trackThickness="4dp" />
    </FrameLayout>

</RelativeLayout>
