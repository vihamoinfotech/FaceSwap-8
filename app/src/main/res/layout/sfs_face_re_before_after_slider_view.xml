<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/sfs_re_base_card_bkg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <!-- BEFORE (original) image — BOTTOM layer, always fully visible -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSliderBefore"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/SFS_RoundedCornerPhoto" />

        <!-- AFTER (result) image — TOP layer, clipped to reveal from left -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSliderAfter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/SFS_RoundedCornerPhoto" />

        <!-- Vertical divider line -->
        <View
            android:id="@+id/sliderLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginVertical="@dimen/_5sdp"
            android:background="#FFFFFFFF"
            android:elevation="4dp"
            android:visibility="invisible" />

        <!-- Draggable circular handle -->
        <ImageView
            android:id="@+id/sliderHandle"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:contentDescription="Slider handle"
            android:elevation="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sfs_face_re_slider_handle_horizontal"
            android:visibility="invisible" />

        <!-- Loading progress indicator -->
        <ProgressBar
            android:id="@+id/sliderProgress"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/sfs_white"
            android:visibility="gone" />

        <!-- "Before" label (top-left) -->
        <TextView
            android:id="@+id/tvSliderBeforeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_margin="@dimen/_10sdp"
            android:background="@drawable/sfs_re_full_slider_label_black"
            android:fontFamily="@font/sfs_re_poppins_semibold"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:text="@string/sfs_face_re_slider_before_text"
            android:textColor="#1A1A2E"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- "After" label (top-right) -->
        <TextView
            android:id="@+id/tvSliderAfterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_margin="@dimen/_10sdp"
            android:background="@drawable/sfs_re_full_slider_label_black"
            android:fontFamily="@font/sfs_re_poppins_semibold"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:text="@string/sfs_face_re_slider_after_text"
            android:textColor="#1A1A2E"
            android:textSize="11sp"
            android:visibility="gone" />

    </androidx.cardview.widget.CardView>

</FrameLayout>
