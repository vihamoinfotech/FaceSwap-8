<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Background placeholder (kept for Java compatibility) -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/downloadShareContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:paddingHorizontal="@dimen/_6sdp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/view_all_bg"
                android:contentDescription="@string/app_face_back_text"
                android:padding="@dimen/_10sdp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                style="@style/HeaderTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:includeFontPadding="false"
                android:text="@string/app_download_share_text" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/view_all_bg"
                android:contentDescription="@string/cd_share"
                android:padding="@dimen/_10sdp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_share"
                app:tint="@color/white" />
        </RelativeLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_subtle" />

        <!-- Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/ll_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_above="@+id/ad_view_container"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_14sdp"
                    android:layout_alignWithParentIfMissing="true"
                    >

                    <!-- Edit button below slider -->
                    <ImageView
                        android:id="@+id/btnedit"
                        android:layout_width="@dimen/_45sdp"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_gravity="end"
                        android:background="@drawable/bg_generate_button"
                        android:contentDescription="@string/app_edit_text"
                        android:padding="@dimen/_12sdp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_edit_overlay"
                        app:tint="@color/white" />

                    <!-- Download button (fixed bottom) -->
                    <Button
                        android:id="@+id/btnDownload"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:background="@drawable/bg_generate_button"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.02"
                        android:text="@string/download_share_save_to_gallery"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_15sdp"
                        app:backgroundTint="@null"
                        app:cornerRadius="16dp" />

                </LinearLayout>


                <!-- Result preview (scrollable above button) -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/ll_bottom"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_16sdp">

                        <!-- "Your result is ready" badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_12sdp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="@dimen/_3sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:background="@drawable/bg_badge_orange" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:fontFamily="@font/poppins_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/download_share_your_result_is_ready"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_15sdp" />
                        </LinearLayout>

                        <!-- Before / After comparison slider -->
                        <com.facechanger.faceswap.enhance.view.widget.BeforeAfterSliderView
                            android:id="@+id/beforeAfterSlider"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_350sdp"
                            android:layout_gravity="center" />

                        <!-- Used for single-image preview when there is no Before image -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivResultPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/RoundedCornerImage" />

                        <!-- Used for video preview -->
                        <androidx.media3.ui.PlayerView
                            android:id="@+id/playerView"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_350sdp"
                            android:visibility="gone"
                            app:use_controller="true"
                            app:show_buffering="when_playing"
                            android:background="@color/black" />
                    </LinearLayout>
                </ScrollView>

                <FrameLayout
                    android:id="@+id/ad_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:paddingVertical="@dimen/_2sdp" />

            </RelativeLayout>
        </FrameLayout>

    </LinearLayout>

</RelativeLayout>
