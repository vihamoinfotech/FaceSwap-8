<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_theme_dark_background">

    <!-- Background placeholder — src set programmatically if needed -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Header ── -->
        <RelativeLayout
            android:id="@+id/mainActContent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            android:paddingHorizontal="@dimen/_16sdp">

            <!-- Left: Logo + App name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_app_logo" />

                <TextView
                    style="@style/HeaderTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/app_poppins_extrabold"
                    android:includeFontPadding="false"
                    android:text="@string/app_builder_name"
                    android:textColor="#1A1A2E" />

            </LinearLayout>

            <!-- Right: Coin pill + Settings button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Coin balance pill (visibility controlled by Java) -->
                <LinearLayout
                    android:id="@+id/coinBalancePill"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:background="@drawable/app_pill_face_solid_gradient"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_4sdp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:contentDescription="@string/app_face_total_coin_balance_text"
                        android:src="@drawable/app_face_coin_new" />

                    <TextView
                        android:id="@+id/tvCoinBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:fontFamily="@font/app_poppins_semibold"
                        android:includeFontPadding="false"
                        android:paddingEnd="@dimen/_2sdp"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_14sdp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/app_face_all_view_layer"
                    android:clickable="true"
                    android:contentDescription="@string/app_face_settings_text"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/app_face_settings_header_wheel"
                        app:tint="#1A1A2E" />

                </FrameLayout>

            </LinearLayout>
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/app_subtle_divider" />

        <!-- Ad banner slot -->
        <FrameLayout
            android:id="@+id/ad_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Scrollable content area -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- New Feature Hub Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignWithParentIfMissing="true"
                android:layout_above="@+id/second_ad_view_container"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/_16sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/_24sdp">

                    <!-- Hero Banner -->
                    <include layout="@layout/app_home_header_item" />

                    <!-- Explore Templates Card -->
                    <RelativeLayout
                        android:id="@+id/cardExploreTemplates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_16sdp"
                        android:layout_marginBottom="@dimen/_16sdp"
                        android:background="@drawable/app_home_explore_templates_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="@dimen/_14sdp"
                        android:paddingVertical="@dimen/_16sdp">

                        <ImageView
                            android:id="@+id/ivTemplateIcon"
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_explore_templates" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_toEndOf="@id/ivTemplateIcon"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/app_poppins_bold"
                                android:includeFontPadding="false"
                                android:text="@string/app_home_explore_templates"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/_14sdp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/app_poppins_regular"
                                android:includeFontPadding="false"
                                android:text="@string/app_home_explore_subtitle"
                                android:textColor="#F3E8FF"
                                android:textSize="@dimen/_10sdp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/app_face_arrow_right"
                            app:tint="#FFFFFF" />
                    </RelativeLayout>

                    <!-- Quick Actions Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_16sdp"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:fontFamily="@font/app_poppins_bold"
                        android:includeFontPadding="false"
                        android:text="@string/app_home_quick_actions"
                        android:textColor="#1A1A2E"
                        android:textSize="@dimen/_14sdp" />

                    <!-- Quick Actions Grid -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:columnCount="2"
                        android:rowCount="2">

                        <!-- Video Swap Card -->
                        <FrameLayout
                            android:id="@+id/cardVideoSwap"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/_4sdp"
                            android:background="@drawable/app_home_grid_bg_video_swap"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/app_home_feature_card_ripple">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="@dimen/_16sdp">

                                <ImageView
                                    android:layout_width="@dimen/_24sdp"
                                    android:layout_height="@dimen/_24sdp"
                                    android:src="@drawable/app_face_video_reverse_eng"
                                    app:tint="#6366F1" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_8sdp"
                                    android:fontFamily="@font/app_poppins_semibold"
                                    android:includeFontPadding="false"
                                    android:text="@string/app_home_video_swap"
                                    android:textColor="#6366F1"
                                    android:textSize="@dimen/_11sdp" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Remove BG Card -->
                        <FrameLayout
                            android:id="@+id/cardRemoveBg"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/_4sdp"
                            android:background="@drawable/app_home_grid_bg_remove_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/app_home_feature_card_ripple">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="@dimen/_16sdp">

                                <ImageView
                                    android:layout_width="@dimen/_24sdp"
                                    android:layout_height="@dimen/_24sdp"
                                    android:src="@drawable/ic_remove_bg"
                                    app:tint="#06B6D4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_8sdp"
                                    android:fontFamily="@font/app_poppins_semibold"
                                    android:includeFontPadding="false"
                                    android:text="@string/app_home_remove_bg"
                                    android:textColor="#06B6D4"
                                    android:textSize="@dimen/_11sdp" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Enhance Card -->
                        <FrameLayout
                            android:id="@+id/cardEnhanceFace"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/_4sdp"
                            android:background="@drawable/app_home_grid_bg_enhance"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/app_home_feature_card_ripple">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="@dimen/_16sdp">

                                <ImageView
                                    android:layout_width="@dimen/_24sdp"
                                    android:layout_height="@dimen/_24sdp"
                                    android:src="@drawable/ic_enhance_face"
                                    app:tint="#FF8A3D" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_8sdp"
                                    android:fontFamily="@font/app_poppins_semibold"
                                    android:includeFontPadding="false"
                                    android:text="@string/app_home_enhance_face"
                                    android:textColor="#FF8A3D"
                                    android:textSize="@dimen/_11sdp" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- My Work Card -->
                        <FrameLayout
                            android:id="@+id/cardMyWork"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/_4sdp"
                            android:background="@drawable/app_home_grid_bg_my_work"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="@drawable/app_home_feature_card_ripple">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="@dimen/_16sdp">

                                <ImageView
                                    android:layout_width="@dimen/_24sdp"
                                    android:layout_height="@dimen/_24sdp"
                                    android:src="@drawable/app_face_my_work_four"
                                    app:tint="#8B5CF6" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_8sdp"
                                    android:fontFamily="@font/app_poppins_semibold"
                                    android:includeFontPadding="false"
                                    android:text="@string/app_home_my_work"
                                    android:textColor="#8B5CF6"
                                    android:textSize="@dimen/_11sdp" />
                            </LinearLayout>
                        </FrameLayout>

                    </GridLayout>

                </LinearLayout>
            </ScrollView>



            <FrameLayout
                android:id="@+id/second_ad_view_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_2sdp" />

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
