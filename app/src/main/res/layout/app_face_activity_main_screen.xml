<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_theme_dark_background">

    <!-- Background placeholder — src set programmatically if needed -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Header ── -->
        <RelativeLayout
            android:id="@+id/mainActContent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:paddingHorizontal="@dimen/_14sdp">

            <!-- Left: Logo + App name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_app_logo" />

                <TextView
                    style="@style/HeaderTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/app_poppins_extrabold"
                    android:includeFontPadding="false"
                    android:text="@string/app_builder_name"
                    android:textColor="@color/white" />

            </LinearLayout>

            <!-- Right: Coin pill + Settings button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Coin balance pill (visibility controlled by Java) -->
                <LinearLayout
                    android:id="@+id/coinBalancePill"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:background="@drawable/app_pill_face_solid_gradient"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_3sdp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:contentDescription="@string/app_face_total_coin_balance_text"
                        android:src="@drawable/app_face_coin_new" />

                    <TextView
                        android:id="@+id/tvCoinBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:fontFamily="@font/app_poppins_semibold"
                        android:includeFontPadding="false"
                        android:paddingEnd="@dimen/_2sdp"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sdp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/app_face_all_view_layer"
                    android:clickable="true"
                    android:contentDescription="@string/app_face_settings_text"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/app_face_settings_header_wheel"
                        app:tint="@color/white" />

                </FrameLayout>

            </LinearLayout>
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/app_subtle_divider" />

        <!-- Ad banner slot -->
        <FrameLayout
            android:id="@+id/ad_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Scrollable content area -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMainCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignWithParentIfMissing="true"
                android:layout_above="@+id/second_ad_view_container"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/app_clip_home_main_scroll_content_bottom_padding_points" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_view_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignWithParentIfMissing="true"
                android:layout_above="@+id/second_ad_view_container"
                android:visibility="gone"
                app:shimmer_auto_start="false"
                app:shimmer_duration="1200">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/app_shimmer_main_category_item" />

                    <include layout="@layout/app_shimmer_main_category_item" />

                    <include layout="@layout/app_shimmer_main_category_item" />

                </LinearLayout>

            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Bottom nav bar + ad overlay -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignWithParentIfMissing="true"
                android:layout_above="@+id/second_ad_view_container">

                <LinearLayout
                    android:id="@+id/bottomNavBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignWithParentIfMissing="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="@dimen/app_clip_home_bottom_bar_margin_bottom_point"
                    android:background="@drawable/app_face_bottom_nav_bar_bg"
                    android:elevation="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_4sdp"
                    android:paddingVertical="@dimen/_4sdp">

                    <!-- AI Image tab -->
                    <LinearLayout
                        android:id="@+id/navAiImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:duplicateParentState="true"
                            android:src="@drawable/app_face_generative_chat_ai"
                            app:tint="@color/app_face_nav_tab_tint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/app_poppins_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/app_ai_image_text"
                            android:textColor="@color/app_face_nav_tab_tint"
                            android:textSize="@dimen/_9sdp" />

                        <TextView
                            android:id="@+id/tvCostAiImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/app_poppins_bold"
                            android:includeFontPadding="false"
                            android:text="10"
                            android:textColor="@color/app_primary_brand"
                            android:textSize="@dimen/_8sdp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Multi Swap tab -->
                    <LinearLayout
                        android:id="@+id/navMultiSwap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:duplicateParentState="true"
                            android:src="@drawable/app_face_video_reverse_eng"
                            app:tint="@color/app_face_nav_tab_tint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/app_poppins_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/app_multi_swap_video_text"
                            android:textColor="@color/app_face_nav_tab_tint"
                            android:textSize="@dimen/_9sdp" />

                        <TextView
                            android:id="@+id/tvCostMultiSwap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/app_poppins_bold"
                            android:includeFontPadding="false"
                            android:text="10"
                            android:textColor="@color/app_primary_brand"
                            android:textSize="@dimen/_8sdp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Face Swap tab -->
                    <LinearLayout
                        android:id="@+id/navFaceSwap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:duplicateParentState="true"
                            android:src="@drawable/app_face_rotation_face_swap_bg"
                            app:tint="@color/app_face_nav_tab_tint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/app_poppins_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/app_main_face_swap_text"
                            android:textColor="@color/app_face_nav_tab_tint"
                            android:textSize="@dimen/_9sdp" />

                        <TextView
                            android:id="@+id/tvCostFaceSwap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/app_poppins_bold"
                            android:includeFontPadding="false"
                            android:text="10"
                            android:textColor="@color/app_primary_brand"
                            android:textSize="@dimen/_8sdp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- My Work tab -->
                    <LinearLayout
                        android:id="@+id/navMyWork"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:duplicateParentState="true"
                            android:src="@drawable/app_face_my_work_four"
                            app:tint="@color/app_face_nav_tab_tint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:duplicateParentState="true"
                            android:fontFamily="@font/app_poppins_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/app_main_work_text"
                            android:textColor="@color/app_face_nav_tab_tint"
                            android:textSize="@dimen/_9sdp" />
                    </LinearLayout>
                </LinearLayout>

            </RelativeLayout>

            <FrameLayout
                android:id="@+id/second_ad_view_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="@dimen/_2sdp" />

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
