<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: Retry
     IDs: ivDialogIcon, tvDialogTitle, tvDialogMessage, btnDialogPositive -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_10sdp"
    android:layout_marginHorizontal="@dimen/_20sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sfs_face_re_dlog_rounded_slight"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/_24sdp"
        android:paddingTop="@dimen/_36sdp"
        android:paddingEnd="@dimen/_24sdp"
        android:paddingBottom="@dimen/_24sdp">

        <!-- Icon with glow ring -->
        <FrameLayout
            android:layout_width="@dimen/_88sdp"
            android:layout_height="@dimen/_88sdp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/sfs_re_logo_glow_update" />

            <ImageView
                android:id="@+id/ivDialogIcon"
                android:layout_width="@dimen/_56sdp"
                android:layout_height="@dimen/_56sdp"
                android:layout_gravity="center"
                android:contentDescription="@string/sfs_re_dlog_icon_text"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:fontFamily="@font/sfs_re_poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#1A1A2E"
            android:textSize="@dimen/_20sdp" />

        <!-- Gradient accent divider -->
        <View
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/sfs_face_re_bfge_orange_gradient_bg" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvDialogMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:fontFamily="@font/sfs_re_poppins_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/sfs_re_secondary_text"
            android:textSize="@dimen/_12sdp" />

        <!-- Action button -->
        <TextView
            android:id="@+id/btnDialogPositive"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginTop="@dimen/_22sdp"
            android:background="@drawable/sfs_face_re_dlog_button_gradient_horizontal"
            android:fontFamily="@font/sfs_re_poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:textColor="#1A1A2E"
            android:textSize="@dimen/_14sdp" />

    </LinearLayout>
</FrameLayout>
