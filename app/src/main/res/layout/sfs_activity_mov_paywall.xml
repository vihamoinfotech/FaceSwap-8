<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Full screen background video player -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerViewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_150sdp"
        app:use_controller="false"
        app:resize_mode="zoom"
        app:surface_type="surface_view"
        app:shutter_background_color="@android:color/transparent" />

    <!-- Gradient overlay for text legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_150sdp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/sfs_face_re_mov_paywall_gradient_overlay" />

    <ImageView
        android:id="@+id/btnPaywallClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:alpha="0.4"
        android:contentDescription="@string/sfs_paywall_close"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/sfs_re_trans_close_choose" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btnPaywallCta">

        <TextView
            android:id="@+id/tv_gol_offer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/sfs_re_manrope_bold"
            android:includeFontPadding="false"
            android:text="Unlimited Creativity"
            android:textAlignment="center"
            android:textColor="#1A1A2E"
            android:textSize="@dimen/_18sdp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tv_gol_offer_desc"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_40sdp"
            android:layout_below="@+id/tv_gol_offer_title"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/sfs_re_manrope_regular"
            android:includeFontPadding="false"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/sfs_re_secondary_text"
            android:textSize="@dimen/_11sdp"
            android:visibility="visible" />

        <ProgressBar
            android:id="@+id/paywallProgressBar"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_below="@+id/tv_gol_offer_title"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/sfs_re_primary_paywall"
            android:visibility="gone" />

    </RelativeLayout>

    <TextView
        android:id="@+id/btnPaywallCta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/footer_vw"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        android:background="@drawable/sfs_face_re_premium_center_button"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/sfs_re_manrope_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingVertical="@dimen/_12sdp"
        android:text=""
        android:textColor="#1A1A2E"
        android:textSize="@dimen/_14sdp" />

    <LinearLayout
        android:id="@+id/footer_vw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/_5sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPaywallTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/sfs_re_manrope_regular"
            android:includeFontPadding="false"
            android:text="@string/sfs_paywall_terms"
            android:textColor="@color/sfs_re_outline_variant_paywall"
            android:textSize="@dimen/_9sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.4"
            android:paddingHorizontal="12dp"
            android:text="|"
            android:textColor="@color/sfs_re_outline_variant_paywall"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPaywallRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/sfs_re_manrope_regular"
            android:includeFontPadding="false"
            android:text="@string/sfs_paywall_restore"
            android:textColor="@color/sfs_re_outline_variant_paywall"
            android:textSize="@dimen/_9sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.4"
            android:paddingHorizontal="12dp"
            android:text="|"
            android:textColor="@color/sfs_re_outline_variant_paywall"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPaywallPrivacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.4"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/sfs_re_manrope_regular"
            android:includeFontPadding="false"
            android:text="@string/sfs_paywall_privacy"
            android:textColor="@color/sfs_re_outline_variant_paywall"
            android:textSize="@dimen/_9sdp" />
    </LinearLayout>

</RelativeLayout>