<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="SFS_Base.Theme.FaceSwap" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/sfs_re_manrope_regular</item>
        <item name="fontFamily">@font/sfs_re_manrope_regular</item>
        <item name="android:windowBackground">@color/sfs_re_theme_dark_bkg</item>
    </style>

    <style name="SFS_Theme.FaceSwap" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">@font/sfs_re_manrope_regular</item>
        <item name="fontFamily">@font/sfs_re_manrope_regular</item>
        <item name="android:windowBackground">@color/sfs_re_theme_dark_bkg</item>
        <item name="colorPrimary">@color/sfs_re_primary_brand</item>
        <item name="colorPrimaryVariant">#FFFFFF</item>
        <item name="colorOnPrimary">@color/sfs_white</item>
        <item name="color">#FAF2F2F2</item>
        <item name="colorSecondary">#0091EA</item>
        <item name="colorSecondaryVariant">#015386</item>
        <item name="colorOnSecondary">@color/sfs_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="SFS_RoundedCornerPhoto">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="SFS_CirclePhoto">
        <item name="cornerSize">50%</item>
    </style>

    <style name="SFS_RoundedPhotoMedium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="SFS_Theme.FaceSwap.Spl" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sfs_re_theme_dark_bkg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/SFS_Theme.FaceSwap</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="SFS_HeaderTextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/sfs_re_manrope_semibold</item>
        <item name="android:textColor">#1A1A2E</item>
        <item name="android:lines">1</item>
        <item name="android:textSize">@dimen/_18sdp</item>
    </style>

    <style name="SFS_SettingsRowTextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/sfs_re_manrope_medium</item>
        <item name="android:textColor">#1A1A2E</item>
        <item name="android:textSize">@dimen/_13sdp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SFS_SectionLabelStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/sfs_re_manrope_semibold</item>
        <item name="android:textColor">#9CA3AF</item>
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SFS_SubtitleTextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/sfs_re_manrope_regular</item>
        <item name="android:textColor">#6B7280</item>
        <item name="android:textSize">@dimen/_11sdp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
