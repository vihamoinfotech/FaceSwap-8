<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.FaceSwap" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_theme_dark_background</item>
    </style>

    <style name="Theme.FaceSwap" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_theme_dark_background</item>
        <item name="colorPrimary">@color/app_primary_brand</item>
        <item name="colorPrimaryVariant">#FFFFFF</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="color">#FAF2F2F2</item>
        <item name="colorSecondary">#0091EA</item>
        <item name="colorSecondaryVariant">#015386</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="RoundedCornerImage">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedImageMedium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Theme.FaceSwap.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_theme_dark_background</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.FaceSwap</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="HeaderTextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/app_poppins_semibold</item>
        <item name="android:textColor">#1A1A2E</item>
        <item name="android:lines">1</item>
        <item name="android:textSize">@dimen/_18sdp</item>
    </style>

    <style name="SettingsRowTextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/app_poppins_medium</item>
        <item name="android:textColor">#1A1A2E</item>
        <item name="android:textSize">@dimen/_13sdp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SectionLabelStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/app_poppins_semibold</item>
        <item name="android:textColor">#9CA3AF</item>
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SubtitleTextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/app_poppins_regular</item>
        <item name="android:textColor">#6B7280</item>
        <item name="android:textSize">@dimen/_11sdp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
