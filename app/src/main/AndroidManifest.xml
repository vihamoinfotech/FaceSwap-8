<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Gallery / Storage (pre-API 33) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Gallery / Storage (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Storage write (for saving to gallery on API < 29) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AppFaceSwap"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/face_data_file_extraction_rules"
        android:fullBackupContent="@xml/face_backup_file_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_builder_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FaceSwap">

        <!-- Workaround for Google Play Billing Library crash (NullPointerException on PendingIntent) -->
        <!-- Adding additional configChanges prevents activity recreation on Dark Mode/Locale/Font changes -->
        <activity
            android:name="com.android.billingclient.api.ProxyBillingActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="false"
            tools:replace="android:configChanges" />
            
        <activity
            android:name="com.android.billingclient.api.ProxyBillingActivityV2"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="false"
            tools:replace="android:configChanges" />

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".view.AppFaceSplashActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FaceSwap.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main -->
        <activity
            android:name=".view.AppFaceMainActivity"
            android:screenOrientation="portrait"
            android:exported="false"/>
        <activity
            android:name=".view.AppFaceOnboardingActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceAppUpdateActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceLoadingActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- Features -->
        <activity
            android:name=".view.AppFaceSectionDetailActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceSwapActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceDownloadShareActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceFaceSelectionActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceEditImageActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceMultiSwapActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceMyWorkActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceAiImageGenActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceSettingsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceBackgroundPickerActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.FaceSwap" />
        <activity
            android:name=".view.AppFaceStoreActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceCoinHistoryActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceLanguageActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- New AI Tool Activities -->
        <activity
            android:name=".view.AppFaceFaceEnhanceActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceBackgroundReplaceActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceCoupleFaceSwapActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceTextToImageActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFaceVideoFaceSwapActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".view.AppFacePaywallActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.FaceSwap" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>

        <meta-data android:name="com.google.android.gms.ads.flag.NATIVE_AD_DEBUGGER_ENABLED"
            android:value="false" />

        <!-- Facebook SDK Metadata Configurations -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />

        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />

        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="true" />

        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="true" />

        <!-- Firebase Cloud Messaging default notification config -->
        <!-- These are used when the app is in background/killed and FCM auto-displays -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/app_notification_little" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="faceswap_push_channel" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
                tools:replace="android:resource"/>
        </provider>

        <!-- Firebase Messaging Service -->
        <service
            android:name=".service.AppFaceMyFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Local Notification Receiver -->
        <receiver android:name=".worker.AppFaceLocalNotificationReceiver" android:exported="false" />

    </application>

</manifest>
