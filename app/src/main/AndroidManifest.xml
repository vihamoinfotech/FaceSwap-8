<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Gallery / Storage (pre-API 33) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Gallery / Storage (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Storage write (for saving to gallery on API < 29) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SFS_RefaceSwap"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/sfs_face_data_file_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/sfs_face_backup_file_rules"
        android:icon="@mipmap/sfs_ic_launcher"
        android:label="@string/sfs_re_builder_name"
        android:roundIcon="@mipmap/sfs_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/SFS_Theme.FaceSwap">
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <!-- Workaround for Google Play Billing Library crash (NullPointerException on PendingIntent) -->
        <!-- Adding additional configChanges prevents activity recreation on Dark Mode/Locale/Font changes -->
        <activity
            android:name="com.android.billingclient.api.ProxyBillingActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="false"
            tools:replace="android:configChanges" />

        <activity
            android:name="com.android.billingclient.api.ProxyBillingActivityV2"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="false"
            tools:replace="android:configChanges" />

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".view.SFS_RefaceSplActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/SFS_Theme.FaceSwap.Spl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.SFS_LgnActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".view.SFS_SgnupActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".view.SFS_EditNameActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Main -->
        <activity
            android:name=".view.SFS_RefaceMainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceIntroingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceAppUpdateActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceLoadingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Features -->
        <activity
            android:name=".view.SFS_RefaceSectionDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefacePosterGalleryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceSwapActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceDownloadShareActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceFaceSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceEditPhotoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceMultiSwapActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceMyWorkActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceAiPhotoGenActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceBackgroundSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/SFS_Theme.FaceSwap" />
        <activity
            android:name=".view.SFS_RefaceCoinStreActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceCoinHistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceLanguageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- New AI Tool Activities -->
        <activity
            android:name=".view.SFS_RefaceFaceEnhanceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceRemoveBgActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceCoupleFaceSwapActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceTextToPhotoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefaceMovieFaceSwapActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SFS_RefacePremiumActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/SFS_Theme.FaceSwap" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.NATIVE_AD_DEBUGGER_ENABLED"
            android:value="false" />

        <!-- Facebook SDK Metadata Configurations -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/sfs_facebook_re_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/sfs_facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="true" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="true" />

        <!-- Firebase Cloud Messaging default notification config -->
        <!-- These are used when the app is in background/killed and FCM auto-displays -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/sfs_re_notification_little" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="faceswap_push_channel" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/sfs_file_paths"
                tools:replace="android:resource" />
        </provider>

        <!-- Firebase Messaging Service -->
        <service
            android:name=".service.SFS_RefaceMyFierbusMessService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Local Notification Receiver -->
        <receiver
            android:name=".worker.SFS_RefaceLocalNotiReceiver"
            android:exported="false" />

        <activity
            android:name=".view.SFS_MoviePremiumActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>